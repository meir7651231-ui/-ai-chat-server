var fmtMonthYear = Intl.DateTimeFormat('he', {'month': 'long', 'year': 'numeric'});
var fmtHebMonth = Intl.DateTimeFormat('he-u-ca-hebrew', {'month': 'long'});
var fmtHebYear = Intl.DateTimeFormat('he-u-ca-hebrew', {'year': 'numeric'});
dynamic buildMonthGrid(dynamic events, dynamic anchorIso, dynamic hebMode, dynamic cellOf, dynamic isoOf, dynamic hpOf, dynamic gemYear) {
  var byDate = <dynamic, dynamic>{};
  for (final ev in events) {
  if (_falsy(ev.date)) continue;
  var arr = (byDate.get(ev.date) ?? []);
  arr.add(ev);
  byDate.set(ev.date, arr);
}
  var anchor = DateTime.parse(anchorIso + 'T12:00:00');
  if (_falsy(hebMode)) {
  var first = DateTime.parse(anchor.year, (anchor.month - 1), 1);
  var start = DateTime.parse(first.year, (first.month - 1), 1 - first.weekday % 7);
  var cells = [];
  for (var i = 0; i < 42; i++) {
  var d = DateTime.parse(start.year, (start.month - 1), start.day + i);
  cells.add(cellOf(d, (d.month - 1) == (anchor.month - 1), false, byDate));
}
  return {'cells': cells, 'label': fmtMonthYear.format(first), 'subLabel': fmtHebMonth.format(first) + '–' + fmtHebMonth.format(DateTime.parse(anchor.year, (anchor.month - 1) + 1, 0)), 'prevIso': isoOf(DateTime.parse(first.year, (first.month - 1) - 1, 15)), 'nextIso': isoOf(DateTime.parse(first.year, (first.month - 1) + 1, 15))};
}
  var d = DateTime.parse(anchor);
  while (hpOf(isoOf(d), d).day != 1) d = DateTime.parse(d.year, (d.month - 1), d.day - 1);
  var first = d;
  var monthName = hpOf(isoOf(first), first).month;
  var days = [];
  var cur = first;
  while (hpOf(isoOf(cur), cur).month == monthName && days.length < 31) {
  days.add(cur);
  cur = DateTime.parse(cur.year, (cur.month - 1), cur.day + 1);
}
  var last = days[days.length - 1];
  var cells = [];
  for (var i = first.weekday % 7; i > 0; i--) cells.add(cellOf(DateTime.parse(first.year, (first.month - 1), first.day - i), false, true, byDate));
  for (final day in days) cells.add(cellOf(day, true, true, byDate));
  while (cells.length % 7 != 0) {
  var lastCell = DateTime.parse(cells[cells.length - 1].iso + 'T12:00:00');
  cells.add(cellOf(DateTime.parse(lastCell.year, (lastCell.month - 1), lastCell.day + 1), false, true, byDate));
}
  return {'cells': cells, 'label': monthName + ' ' + gemYear(fmtHebYear.format(first)), 'subLabel': fmtMonthYear.format(first) + ' – ' + fmtMonthYear.format(last), 'prevIso': isoOf(DateTime.parse(first.year, (first.month - 1), first.day - 1)), 'nextIso': isoOf(DateTime.parse(last.year, (last.month - 1), last.day + 1))};
}
