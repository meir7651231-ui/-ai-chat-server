dynamic parseAnyDate(dynamic v) {
  var s = (v ?? '').toString().trim();
  if (_falsy(s)) return '';
  var iso = s.match(RegExp(r'^(\d{4})-(\d{2})-(\d{2})$'));
  if (iso) {
  var y = +iso[1];
  var mon = +iso[2];
  var day = +iso[3];
  if ((((mon < 1 || mon > 12) || day < 1) || day > 31)) return '';
  var probe = DateTime.parse(Date.UTC(y, mon - 1, day));
  if (((probe.getUTCFullYear() != y || probe.getUTCMonth() != mon - 1) || probe.getUTCDate() != day)) return '';
  return s;
}
  var m = s.match(RegExp(r'^(\d{1,2})[./-](\d{1,2})[./-](\d{2,4})$'));
  if (m) {
  var day = +m[1];
  var mon = +m[2];
  var y = +m[3];
  if (y < 100) {
  var cut = (DateTime.now().year % 100) + 10;
  y += y <= cut ? 2000 : 1900;
}
  if ((((mon < 1 || mon > 12) || day < 1) || day > 31)) return '';
  var probe = DateTime.parse(Date.UTC(y, mon - 1, day));
  if (((probe.getUTCFullYear() != y || probe.getUTCMonth() != mon - 1) || probe.getUTCDate() != day)) return '';
  return y + '-' + mon.toString()._padStart(2, '0') + '-' + day.toString()._padStart(2, '0');
}
  if (RegExp(r'^\d{5}$').test(s)) {
  var b = DateTime.parse(Date.UTC(1899, 11, 30));
  b.setUTCDate(b.getUTCDate() + +s);
  return b.toIso8601String().sublist(0, 10);
}
  return '';
}