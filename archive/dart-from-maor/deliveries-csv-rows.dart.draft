dynamic deliveriesCsvRows(dynamic db, dynamic config, dynamic termOf, dynamic statusLabel) {
  dynamic T(dynamic k, dynamic fb) => (config ? termOf(config, k, fb) : fb);
  dynamic dayDate(dynamic id) => (db.distributionDays.firstWhere((d) => d.id == id).date ?? '');
  dynamic famName(dynamic id) => (db.families.firstWhere((f) => f.id == id).name ?? '');
  dynamic famAddr(dynamic id) {
  var f = db.families.firstWhere((x) => x.id == id);
  return f ? [f.address, f.city].map((s) => ((s ?? '')).trim()).toList().where(Boolean).join(', ') : '';
}
  dynamic volName(dynamic id) => (db.volunteers.firstWhere((v) => v.id == id).name ?? '');
  var rows = [['תאריך', T('entity.family', 'משפחה'), 'כתובת', 'מתנדב', 'סטטוס', 'הערה']];
  for (final d in db.deliveries) {
  rows.add([dayDate(d.dayId), famName(d.familyId), famAddr(d.familyId), volName(d.volunteerId), statusLabel(d.status), (d.note ?? '')]);
}
  return rows;
}
