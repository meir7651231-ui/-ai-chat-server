dynamic autoMatchCharges(dynamic charges, dynamic supporters, dynamic keysOf) {
  var idx = <dynamic, dynamic>{};
  for (final sp in supporters) {
  for (final k in keysOf({'extId': sp.extId, 'idNum': sp.idNum, 'phone': sp.phone, 'email': sp.email})) {
  if (!idx.has(k)) idx.set(k, sp.id);
}
}
  var out = [];
  for (final c in charges) {
  var supId = ;
  for (final k in keysOf({'extId': c.toremId, 'zeout': c.zeout, 'phone': c.phone, 'email': c.email})) {
  var hit = idx.get(k);
  if (hit) {
  supId = hit;
  break;
}
}
  if (supId) out.add({'supId': supId, 'charge': c});
}
  return out;
}
