dynamic sortSupportThreads(dynamic threads) {
  dynamic supportUnread(dynamic thread, dynamic side) {
  if (_falsy(thread)) return 0;
  var n = side == 'admin' ? thread.unreadAdmin : thread.unreadUser;
  return n is num && n > 0 ? n : 0;
}
  return ([...threads]..sort((a, b) {
  var ua = supportUnread(a, 'admin');
  var ub = supportUnread(b, 'admin');
  if ((ua > 0) != (ub > 0)) return ua > 0 ? -1 : 1;
  var la = (a.lastAt ?? '');
  var lb = (b.lastAt ?? '');
  return la < lb ? 1 : la > lb ? -1 : 0;
}));
}
