var ONES = ['', 'אחד', 'שניים', 'שלושה', 'ארבעה', 'חמישה', 'שישה', 'שבעה', 'שמונה', 'תשעה'];
var TEENS = ['עשרה', 'אחד עשר', 'שנים עשר', 'שלושה עשר', 'ארבעה עשר', 'חמישה עשר', 'שישה עשר', 'שבעה עשר', 'שמונה עשר', 'תשעה עשר'];
var TENS = ['', '', 'עשרים', 'שלושים', 'ארבעים', 'חמישים', 'שישים', 'שבעים', 'שמונים', 'תשעים'];
var HUNDREDS = ['', 'מאה', 'מאתיים', 'שלוש מאות', 'ארבע מאות', 'חמש מאות', 'שש מאות', 'שבע מאות', 'שמונה מאות', 'תשע מאות'];
var ONES_F = ['', 'אחת', 'שתיים', 'שלוש', 'ארבע', 'חמש', 'שש', 'שבע', 'שמונה', 'תשע'];
var TEENS_F = ['עשר', 'אחת עשרה', 'שתים עשרה', 'שלוש עשרה', 'ארבע עשרה', 'חמש עשרה', 'שש עשרה', 'שבע עשרה', 'שמונה עשרה', 'תשע עשרה'];
var THOUSAND_CONSTRUCT = {'3': 'שלושת', '4': 'ארבעת', '5': 'חמשת', '6': 'ששת', '7': 'שבעת', '8': 'שמונת', '9': 'תשעת', '10': 'עשרת'};
dynamic words0_999(dynamic n) {
  var out = [];
  var h = _floor(n / 100);
  var rem = n % 100;
  if (h) out.add(HUNDREDS[h]);
  if (rem) {
  if (rem < 10) out.add(ONES[rem]); else if (rem < 20) out.add(TEENS[rem - 10]); else {
  var t = _floor(rem / 10);
  var u = rem % 10;
  out.add(TENS[t]);
  if (u) out.add(ONES[u]);
}
}
  return out;
}
dynamic thousandWords(dynamic th) {
  if (th == 1) return ['אלף'];
  if (th == 2) return ['אלפיים'];
  if (THOUSAND_CONSTRUCT[th]) return [THOUSAND_CONSTRUCT[th] + ' אלפים'];
  return [joinHeb(words0_999(th)) + ' אלף'];
}
dynamic agorotWords(dynamic n) {
  if (n < 10) return ONES_F[n];
  if (n < 20) return TEENS_F[n - 10];
  var t = _floor(n / 10);
  var u = n % 10;
  return u ? TENS[t] + ' ו' + ONES_F[u] : TENS[t];
}
dynamic agorotPhrase(dynamic n) {
  if (n == 1) return 'אגורה אחת';
  if (n == 2) return 'שתי אגורות';
  return agorotWords(n) + ' אגורות';
}
dynamic joinHeb(dynamic words) {
  var w = words.where(Boolean);
  if (w.length == 0) return '';
  if (w.length == 1) return w[0];
  return w.sublist(0, -1).join(' ') + ' ו' + w[w.length - 1];
}
dynamic integerInWords(dynamic n) {
  if ((((!_isFinite(n) || n < 0) || n > 999999999) || _floor(n) != n)) return null;
  if (n == 0) return 'אפס';
  var millions = _floor(n / 1000000);
  var thousands = _floor((n % 1000000) / 1000);
  var rest = n % 1000;
  var groups = [];
  if (millions) {
  if (millions == 1) groups.add('מיליון'); else if (millions == 2) groups.add('שני מיליון'); else groups.add(joinHeb(words0_999(millions)) + ' מיליון');
}
  if (thousands) groups.add(...thousandWords(thousands));
  if (rest) groups.add(...words0_999(rest));
  return joinHeb(groups);
}
dynamic amountInWords(dynamic amount, [dynamic currency = '₪']) {
  if ((!_isFinite(amount) || amount < 0)) return amount.toString();
  var shekelWord = currency == '$' ? {'one': 'דולר אחד', 'many': 'דולרים', 'agName': 'סנט'} : {'one': 'שקל אחד', 'many': 'שקלים', 'agName': 'אגורות'};
  var whole = _floor(amount);
  var agorot = _round((amount - whole) * 100);
  if (agorot == 100) {
  whole += 1;
  agorot = 0;
}
  var wholeWords = integerInWords(whole);
  if (wholeWords == null) {
  return currency + amountfunction toLocaleString() { [native code] };
}
  var s = ;
  if (whole == 1) s = shekelWord.one; else if (whole == 0) s = 'אפס ' + shekelWord.many; else if (whole == 2) s = 'שני ' + shekelWord.many; else s = wholeWords + ' ' + shekelWord.many;
  if (agorot > 0) {
  if (currency == '₪') {
  s += ' ו-' + agorotPhrase(agorot);
} else {
  var agWords = integerInWords(agorot);
  s += ' ו-' + ((agWords ?? agorot)) + ' ' + shekelWord.agName;
}
}
  return s;
}
