var enc = TextEncoder();
dynamic foldIcsLine(dynamic line) {
  var out = [];
  var cur = '';
  var curBytes = 0;
  var limit = 75;
  for (final ch in line) {
  var b = enc.encode(ch).length;
  if (curBytes + b > limit) {
  out.add(cur);
  cur = ' ' + ch;
  curBytes = 1 + b;
  limit = 75;
} else {
  cur += ch;
  curBytes += b;
}
}
  if (cur) out.add(cur);
  return out.length ? out : [''];
}
