dynamic personalCalEntries(dynamic sp, dynamic supDonEvents) {
  var out = supDonEvents(sp).map((e) => ({'date': e.date, 'amount': e.amount, 'cur': e.cur, 'src': e.src})).toList();
  if (sp.nextDate) out.add({'date': sp.nextDate, 'amount': 0, 'cur': '', 'src': '🎯 תאריך יעד לקשר הבא'});
  for (final l in (sp.ayin.log ?? [])) {
  out.add({'date': l.date, 'amount': 0, 'cur': '', 'src': '🧿 ' + l.eyes + (l.name ? ' — ' + l.name : '')});
}
  for (final an in (sp.ayin.answers ?? [])) out.add({'date': an.date, 'amount': 0, 'cur': '', 'src': '📞 תשובה: ' + an.note});
  if (sp.ayin.nextTalk) out.add({'date': sp.ayin.nextTalk, 'amount': 0, 'cur': '', 'src': '🔁 לדבר שוב'});
  return out.where((e) => _falsy(_falsy(e.date)));
}