dynamic faviconDataUri(dynamic emoji) {
  var svg = '<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 100 100\'><text x=\'50\' y=\'52\' font-size=\'72\' text-anchor=\'middle\' dominant-baseline=\'central\'>' + emoji + '</text></svg>';
  return 'data:image/svg+xml,' + encodeURIComponent(svg);
}
