dynamic distributionListLines(dynamic db, dynamic productId, dynamic config, dynamic itemOf, dynamic beneficiaryLabel) {
  var product = db.shopProducts.firstWhere((p) => p.id == productId);
  var lines = ['רשימת חלוקה — ' + ((product.name ?? '')), '='._repeat(30)];
  var active = db.shopAssignments.where((a) => a.productId == productId && a.status == 'active');
  for (final a in active) {
  var fam = db.families.firstWhere((f) => f.id == a.famId);
  var comps = ((product.components ?? [])).map((c) => itemOf(db, c).name).toList().where(Boolean).join(' + ');
  lines.add([beneficiaryLabel(db, a, config), fam ? [fam.address, fam.city].where(Boolean).join(', ') : '', (fam.phone ?? ''), comps, '☐ נמסר'].where(Boolean).join(' · '));
}
  if (active.length == 0) lines.add('אין שיוכים פעילים לחבילה');
  return lines;
}
