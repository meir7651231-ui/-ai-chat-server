dynamic expiringIntakes(dynamic db, dynamic todayIso, dynamic isoOf, [dynamic windowDays = 7]) {
  var horizon = DateTime.parse(todayIso + 'T12:00:00');
  horizon.setDate(horizon.day + windowDays);
  var horizonIso = isoOf(horizon);
  var out = [];
  for (final it in db.shopIntakes) {
  if ((_falsy(it.expiry) || it.expiry > horizonIso)) continue;
  out.add({'intake': it, 'itemName': (db.shopItems.firstWhere((s) => s.id == it.itemId).name ?? '—'), 'expired': it.expiry < todayIso});
}
  return (out..sort((a, b) => ((a.intake.expiry ?? '')).localeCompare((b.intake.expiry ?? ''))));
}
