var FULL_HOLIDAYS = ['ראש השנה', 'ראש השנה ב׳', 'יום כיפור', 'סוכות', 'שמחת תורה', 'פסח', 'שביעי של פסח', 'שבועות', 'תשעה באב'];
dynamic blockReason(dynamic d, [dynamic blockingOn = true], dynamic hebParts, dynamic holidays) {
  if (_falsy(blockingOn)) return null;
  var dow = d.weekday % 7;
  if (dow == 6) return 'שבת';
  if (dow == 5) return 'יום שישי (שעתיים לפני שבת)';
  var hp = hebParts(d);
  var hol = holidays['${hp.month} ${hp.day}'];
  if (hol && FULL_HOLIDAYS.contains(hol)) return hol;
  if (dow == 0 && hp.month == 'Av' && hp.day == 10) return 'תשעה באב (נדחה)';
  if (((hp.month == 'Tishri' && hp.day >= 16 && hp.day <= 21) || (hp.month == 'Nisan' && hp.day >= 16 && hp.day <= 20))) return 'חול המועד';
  return null;
}
