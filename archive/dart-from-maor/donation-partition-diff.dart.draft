dynamic donationPartitionDiff(dynamic prev, dynamic next, dynamic explodeSupporter) {
  dynamic index(dynamic list) {
  var m = <dynamic, dynamic>{};
  for (final sp in list) for (final doc in explodeSupporter(sp)) m.set(doc.id, doc);
  return m;
}
  var prevDocs = index(prev);
  var nextDocs = index(next);
  var sets = [];
  for (final undefined in nextDocs) {
  var before = prevDocs.get(id);
  if ((_falsy(before) || JSON.stringify(before) != JSON.stringify(doc))) sets.add(doc);
}
  var deletes = [];
  for (final id in prevDocs.keys()) if (!nextDocs.has(id)) deletes.add(id);
  return {'sets': sets, 'deletes': deletes};
}
