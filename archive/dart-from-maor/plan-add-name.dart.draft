dynamic planAddName(dynamic a, dynamic rawName, dynamic eyes, dynamic id, dynamic normName, dynamic isoToday) {
  var nm = rawName.trim();
  if (_falsy(nm)) return {'ok': false, 'error': 'הקלידו שם לפני ההוספה'};
  var key = normName(nm);
  if (a.names.any((x) => normName(x.name) == key)) {
  return {'ok': false, 'error': 'השם "${nm}" כבר ברשימה'};
}
  var names = [...a.names, {'id': id, 'name': nm, 'eyes': eyes, 'done': false}];
  if (eyes != '' && eyes != null) {
  return {'ok': true, 'names': names, 'log': [{'date': isoToday(), 'eyes': +eyes, 'name': nm}, ...a.log]};
}
  return {'ok': true, 'names': names};
}