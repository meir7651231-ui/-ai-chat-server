dynamic findAllOpenPlans(dynamic db) {
  var out = [];
  for (final sup in db.supporters) {
  for (final pl in (sup.plannedCharges ?? [])) {
  if ((pl.chargedRid ?? pl.cancelledAt)) continue;
  out.add({'entityType': 'supporter', 'entityId': sup.id, 'plan': pl, 'name': sup.name});
}
}
  for (final en in db.enrollments) {
  if (_falsy(en.plannedCharges.length)) continue;
  var fam = db.families.firstWhere((f) => f.members.any((m) => m.id == en.memberId));
  var mem = fam.members.firstWhere((m) => m.id == en.memberId);
  var nm = (((mem.first ?? '')) + ' ' + ((fam.name ?? ''))).trim();
  for (final pl in en.plannedCharges) {
  if ((pl.chargedRid ?? pl.cancelledAt)) continue;
  out.add({'entityType': 'enrollment', 'entityId': en.id, 'plan': pl, 'name': nm});
}
}
  for (final a in db.shopAssignments) {
  if (_falsy(a.plannedCharges.length)) continue;
  var fam = db.families.firstWhere((f) => f.id == a.famId);
  var nm = (fam.name ?? '');
  for (final pl in a.plannedCharges) {
  if ((pl.chargedRid ?? pl.cancelledAt)) continue;
  out.add({'entityType': 'shopAssignment', 'entityId': a.id, 'plan': pl, 'name': nm});
}
}
  return out;
}
