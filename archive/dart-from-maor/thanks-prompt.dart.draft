dynamic thanksPrompt(dynamic inp) {
  return ['כתוב מכתב תודה קצר (4-6 שורות), חם ואישי, בעברית, מארגון "' + ((inp.orgName ?? 'הארגון')) + '"', 'לתורם/ת בשם "' + inp.supporterName + '" על תרומה של ' + inp.lastAmount + '.', inp.designation ? 'התרומה יועדה ל: ' + inp.designation + '.' : '', inp.totalSoFar ? 'סה"כ תרומותיו/ה עד כה: ' + inp.totalSoFar + ' — אפשר לרמוז לנאמנות בעדינות.' : '', 'בלי הגזמות, בלי סופרלטיבים ריקים, בלי לציין סכומים מעבר לנאמר. לסיים בברכה חמה.', 'להחזיר את המכתב בלבד — בלי הקדמות.'].where(Boolean).join('
');
}
