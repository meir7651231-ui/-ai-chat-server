dynamic weightedQuote(dynamic c, dynamic opts, dynamic lessonPriceForTier, dynamic lessonsInTerm) {
  var perLesson = lessonPriceForTier(c, opts.tier);
  var raw = lessonsInTerm(opts.freq, opts.unit, opts.term, opts.months);
  return {'lessons': _round(raw * 2) / 2, 'perLesson': perLesson, 'total': _round(raw * perLesson)};
}
