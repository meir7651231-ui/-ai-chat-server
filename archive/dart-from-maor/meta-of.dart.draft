dynamic metaOf(dynamic db) {
  return {'orgName': db.orgName, 'orgSite': db.orgSite, 'orgDonate': db.orgDonate, 'orgGoal': db.orgGoal, 'budget': db.budget, 'usdRate': db.usdRate, 'audit': db.audit, 'notif': db.notif, 'reports': db.reports, 'ui': db.ui, 'seq': db.seq, 'receiptSeq': db.receiptSeq, 'donationSeq': db.donationSeq, 'shopReceiptSeq': db.shopReceiptSeq, 'attnDone': db.attnDone, 'savedAt': db.savedAt};
}
