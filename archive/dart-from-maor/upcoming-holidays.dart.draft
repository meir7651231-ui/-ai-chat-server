dynamic upcomingHolidays(dynamic fromIso, [dynamic days = 45], dynamic holidayOf, dynamic isoOf) {
  var out = [];
  var seen = <dynamic>{};
  var start = DateTime.parse(fromIso + 'T12:00:00');
  for (var i = 0; i <= days; i++) {
  var d = DateTime.parse(start.year, (start.month - 1), start.day + i);
  var name = holidayOf(d);
  if (name && !seen.has(name)) {
  seen.add(name);
  out.add({'iso': isoOf(d), 'name': name});
}
}
  return out;
}
