dynamic previewTelephony(dynamic tc, dynamic orgName, dynamic tenantId, dynamic telephonyToTenant, dynamic anchorToday, dynamic validateTenant, dynamic buildTenant, dynamic explainCall, dynamic trustReport) {
  var raw = telephonyToTenant(tc, orgName, tenantId);
  var anchor = anchorToday();
  var opts = {'anchorDate': anchor, 'calendarWindow': 400};
  var v = validateTenant(raw);
  if (_falsy(v.ok)) return {'ok': false, 'errors': v.errors, 'warnings': v.warnings, 'rows': [], 'trust': null, 'files': null};
  var tenant = v.tenant;
  var built = buildTenant(raw, opts);
  var voiceDid = (((tc.numbers.firstWhere((n) => (n.kind == 'sim' || n.kind == 'virtual')) ?? tc.numbers[0])).e164 ?? '');
  var caller = '050-1234567';
  var rows = [];
  var scenarios = [{'when': 'יום שלישי 10:00 (בשעות)', 'call': {'did': voiceDid, 'callerId': caller, 'dow': 2, 'hhmm': '10:00'}}, {'when': 'יום שלישי 20:00 (אחרי-שעות)', 'call': {'did': voiceDid, 'callerId': caller, 'dow': 2, 'hhmm': '20:00'}}, {'when': 'שבת 11:00', 'call': {'did': voiceDid, 'callerId': caller, 'dow': 6, 'hhmm': '11:00'}}];
  for (final s in scenarios) {
  var e = explainCall(tenant, s.call, opts);
  rows.add({'when': s.when, 'caller': caller, 'summary': e.summary, 'outcome': e.outcome});
}
  var trust = null;
  if (built.ok) {
  var tr = trustReport(built);
  trust = {'grade': tr.grade, 'score': tr.score, 'ready': tr.ready, 'failing': tr.failing.map((c) => ({'label': c.label, 'detail': c.detail, 'severity': c.severity})).toList()};
}
  return {'ok': true, 'errors': [], 'warnings': ((built.warnings ?? v.warnings) || []), 'rows': rows, 'trust': trust, 'files': (built.files ?? null)};
}