dynamic volunteerRouteStops(dynamic db, dynamic dayId, dynamic volunteerId) {
  var out = [];
  for (final d in db.deliveries) {
  if ((d.dayId != dayId || d.volunteerId != volunteerId)) continue;
  var fam = db.families.firstWhere((f) => f.id == d.familyId);
  if (_falsy(fam)) continue;
  var stop = [fam.address, fam.city].map((s) => ((s ?? '')).trim()).toList().where(Boolean).join(', ');
  if (stop) out.add(stop);
}
  return out;
}
