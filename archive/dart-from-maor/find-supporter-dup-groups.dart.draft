dynamic findSupporterDupGroups(dynamic supporters, dynamic undefined) {
  var parent = <dynamic, dynamic>{};
  dynamic find(dynamic x) {
  var r = x;
  while (parent.get(r) != r) r = parent.get(r);
  var c = x;
  while (parent.get(c) != r) {
  var nx = parent.get(c);
  parent.set(c, r);
  c = nx;
}
  return r;
}
  dynamic union(dynamic a, dynamic b) {
  var ra = find(a);
  var rb = find(b);
  if (ra != rb) parent.set(ra, rb);
}
  for (final sp in supporters) parent.set(sp.id, sp.id);
  var byPhone = <dynamic, dynamic>{};
  var byEmail = <dynamic, dynamic>{};
  var byId = <dynamic, dynamic>{};
  var byExt = <dynamic, dynamic>{};
  var byNameCity = <dynamic, dynamic>{};
  var byNameSorted = <dynamic, dynamic>{};
  dynamic link(dynamic map, dynamic key, dynamic id) {
  if (_falsy(key)) return ;
  var prev = map.get(key);
  if (prev) union(prev, id); else map.set(key, id);
}
  for (final sp in supporters) {
  var p = normPhone(sp.phone);
  link(byPhone, p.length >= 7 ? p : '', sp.id);
  link(byEmail, ((sp.email ?? '')).trim().toLowerCase(), sp.id);
  link(byId, normId(sp.idNum), sp.id);
  link(byExt, ((sp.extId ?? '')).trim(), sp.id);
  link(byNameCity, supNameCityKey(sp), sp.id);
  var ns = nameSortKey(sp.name);
  link(byNameSorted, ns.contains(' ') ? ns : '', sp.id);
}
  var groups = <dynamic, dynamic>{};
  for (final sp in supporters) {
  var r = find(sp.id);
  ((groups.get(r) ?? groups.set(r, []).get(r))).add(sp.id);
}
  return [...groups.values()].where((g) => g.length >= 2);
}
