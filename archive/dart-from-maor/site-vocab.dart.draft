dynamic siteVocab(dynamic commercial, dynamic lang) {
  var en = lang == 'en';
  if (commercial) {
  return {'heroCta': en ? 'Get in touch' : 'צרו קשר', 'navCta': en ? 'Contact' : 'צרו קשר', 'give': en ? 'Contact us' : 'צרו קשר', 'giveLabel': en ? 'Your request' : 'הפנייה שלך', 'commercial': true};
}
  return {'heroCta': en ? 'Donate now' : 'לתרומה עכשיו', 'navCta': (en ? 'Donate' : 'לתרומה') + ' ♡', 'give': (en ? 'Donate' : 'לתרומה') + ' ♡', 'giveLabel': en ? 'Your gift' : 'התרומה שלך', 'commercial': false};
}
