dynamic finderAxes(dynamic config, dynamic termOf) {
  return [['city', 'עיר'], ['comm', 'קהילה'], ['marital', 'מצב משפחתי'], ['status', 'סטטוס'], ['cred', termOf(config, 'entity.cred', 'אמינות')], ['kids', 'ילדים'], ['enrolled', termOf(config, 'nav.courses', 'חוגים')], ['sefach', 'ספח מלא'], ['lang', 'שפה']];
}
