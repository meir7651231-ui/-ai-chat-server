dynamic telHref(dynamic phone) {
  var cleaned = ((phone ?? '')).replaceFirst(RegExp(r'[^\d+]'), '');
  var digits = cleaned.replaceFirst(RegExp(r'\D'), '');
  if (digits.length < 6) return null;
  return 'tel:' + cleaned;
}
var manualDriver = {'id': 'manual', 'label': 'חיוג בלחיצה (טלפון קיים)', 'capabilities': {'autoDial': false, 'record': false, 'screenPop': true}, 'callHref': (phone) => telHref(phone)};
