dynamic decodeCsvBuffer(dynamic buf) {
  var bytes = Uint8Array(buf);
  if (bytes.length >= 2 && bytes[0] == 255 && bytes[1] == 254) return TextDecoder('utf-16le').decode(buf);
  if (bytes.length >= 2 && bytes[0] == 254 && bytes[1] == 255) return TextDecoder('utf-16be').decode(buf);
  var probe = bytes.subarray(0, 400);
  var nuls = 0;
  for (final b in probe) if (b == 0) nuls++;
  if (probe.length > 8 && nuls > probe.length / 5) return TextDecoder('utf-16le').decode(buf);
  var utf8 = TextDecoder('utf-8').decode(buf);
  if (!utf8.contains('�')) return utf8;
  try {
  return TextDecoder('windows-1255').decode(buf);
} catch (_) {
  return utf8;
}
}
