dynamic reenrollCounts(dynamic rows) {
  var c = {'total': 0, 'yes': 0, 'no': 0, 'hold': 0, 'undecided': 0, 'renewed': 0};
  for (final r in rows) {
  c.total++;
  if (r.renewed) c.renewed++;
  if (r.decision == 'yes') c.yes++; else if (r.decision == 'no') c.no++; else if (r.decision == 'hold') c.hold++; else c.undecided++;
}
  return c;
}