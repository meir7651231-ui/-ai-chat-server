dynamic waDigits(dynamic phone) {
  var d = ((phone ?? '')).replaceFirst(RegExp(r'\D'), '');
  if (_falsy(d)) return null;
  if (d.startsWith('00972')) d = '972' + d.sublist(5); else if (d.startsWith('00')) d = d.sublist(2);
  if (d.startsWith('9720')) d = '972' + d.sublist(4);
  if (!d.startsWith('972') && !d.startsWith('0') && ((d.length == 8 || d.length == 9))) {
  d = '0' + d;
}
  if (d.startsWith('0')) {
  if ((d.length == 9 || d.length == 10)) d = '972' + d.sublist(1); else return null;
}
  if ((d.length < 8 || d.length > 15)) return null;
  return d;
}
