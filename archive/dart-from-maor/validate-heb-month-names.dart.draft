dynamic validateHebMonthNames(dynamic hebYear, dynamic hebParts, dynamic knownMonths) {
  var known = knownMonths;
  var unknown = [];
  var seen = <dynamic>{};
  var gy = hebYear - 3761;
  for (var i = 0; i < 440; i++) {
  var p = hebParts(DateTime.parse(gy, 7, 1 + i, 12));
  if ((p.year != hebYear || seen.has(p.month))) continue;
  seen.add(p.month);
  if (!known.has(p.month)) unknown.add(p.month);
}
  return unknown;
}
