dynamic startCampaign(dynamic name, dynamic ids, dynamic iso) {
  var seen = <dynamic>{};
  var queue = [];
  for (final id in ids) {
  if ((_falsy(id) || seen.has(id))) continue;
  seen.add(id);
  queue.add(id);
}
  return {'name': name, 'startedAt': iso, 'queue': queue, 'total': queue.length, 'log': []};
}
