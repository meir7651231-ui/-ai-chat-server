var ENROLL_NEW_FAMILY = '__new';
dynamic resolveEnrollFamily(dynamic families, dynamic famSel, dynamic newFamName, dynamic normName) {
  var existing = families.firstWhere((f) => f.id == famSel);
  if (existing) return {'fam': existing, 'create': false};
  if (famSel == ENROLL_NEW_FAMILY && newFamName.trim()) {
  var dup = families.firstWhere((f) => normName(f.name) == normName(newFamName));
  if (dup) return {'fam': dup, 'create': false};
  return {'fam': null, 'create': true};
}
  return {'fam': null, 'create': false};
}