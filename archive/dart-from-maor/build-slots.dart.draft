dynamic buildSlots(dynamic db, dynamic room, dynamic iso, dynamic blocked, dynamic config, dynamic undefined, [dynamic cleaningOn = true]) {
  var from = Number.isNaN(timeToMin(room.from)) ? 8 * 60 : timeToMin(room.from);
  var to = Number.isNaN(timeToMin(room.to)) ? 20 * 60 : timeToMin(room.to);
  var step = room.slot > 0 ? room.slot : 60;
  var wd = DateTime.parse(iso + 'T12:00:00').weekday % 7;
  var slots = [];
  var covered = [];
  var dayCourses = db.courses.where((c) => c.roomId == room.id && courseOnDate(c, iso));
  for (var t = from, guard = 0; t < to && guard < 96; t += step , guard++) {
  var hh = minToHM(t);
  if (cleaningOn && t >= 900 && t < 960) {
  slots.add({'key': 'clean' + hh, 'time': hh, 'kind': 'cleaning', 'label': 'ניקיון יומי (15:00–16:00)', 'bg': '#eceae2', 'c': '#4d463c'});
  continue;
}
  var occupied = false;
  for (final c in dayCourses) {
  var ss = sessionsOf(c);
  for (var i = 0; i < ss.length; i++) {
  var tm = timeToMin((ss[i].time ?? ''));
  if (ss[i].day == wd && !Number.isNaN(tm) && tm >= t && tm < t + step) {
  occupied = true;
  covered.add({'c': c, 'i': i});
  slots.add({'key': 'crs|${hh}|${c.id}|${i}', 'time': (ss[i].time ?? hh), 'kind': 'course', 'label': termOf(config, 'entity.course', 'חוג') + ': ' + c.name, 'bg': '#fdf1d4', 'c': '#9a6414', 'course': c, 'session': ss[i], 'sessionIndex': i});
}
}
}
  if (occupied) continue;
  var oe = db.events.firstWhere((ev) {
  if (((ev.done || ev.roomId != room.id) || ev.date != iso)) return false;
  var tm = timeToMin((ev.time ?? ''));
  return !Number.isNaN(tm) && tm >= t && tm < t + step;
});
  if (oe) {
  slots.add({'key': 'ev|' + hh + '|' + oe.id, 'time': (oe.time ?? hh), 'kind': 'event', 'label': 'אירוע: ' + oe.title, 'bg': '#e7edf5', 'c': '#3a5a86', 'event': oe});
} else if (blocked) {
  slots.add({'key': 'blk' + hh, 'time': hh, 'kind': 'blocked', 'label': 'חסום — ' + blocked, 'bg': '#fdeaea', 'c': '#b91c1c'});
} else {
  slots.add({'key': 'free' + hh, 'time': hh, 'kind': 'free', 'label': 'פנוי', 'bg': '#e4f5ea', 'c': '#12803c'});
}
}
  for (final c in dayCourses) {
  var ss = sessionsOf(c);
  for (var i = 0; i < ss.length; i++) {
  if (ss[i].day != wd) continue;
  if (covered.any((x) => x.c.id == c.id && x.i == i)) continue;
  slots.add({'key': 'out|${c.id}|${i}', 'time': (ss[i].time ?? '—'), 'kind': 'course', 'label': termOf(config, 'entity.course', 'חוג') + ': ' + c.name + ' · מחוץ לשעות הפעילות של החדר', 'bg': '#fdf1d4', 'c': '#9a6414', 'course': c, 'session': ss[i], 'sessionIndex': i, 'outOfHours': true});
}
}
  return slots;
}
