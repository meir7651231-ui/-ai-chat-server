dynamic integerInWords(dynamic n, dynamic joinHeb, dynamic words0_999, dynamic thousandWords) {
  if ((((!_isFinite(n) || n < 0) || n > 999999999) || _floor(n) != n)) return null;
  if (n == 0) return 'אפס';
  var millions = _floor(n / 1000000);
  var thousands = _floor((n % 1000000) / 1000);
  var rest = n % 1000;
  var groups = [];
  if (millions) {
  if (millions == 1) groups.add('מיליון'); else if (millions == 2) groups.add('שני מיליון'); else groups.add(joinHeb(words0_999(millions)) + ' מיליון');
}
  if (thousands) groups.add(...thousandWords(thousands));
  if (rest) groups.add(...words0_999(rest));
  return joinHeb(groups);
}
