dynamic deliveryListLines(dynamic rows, dynamic statusLabel) {
  var byVol = <dynamic, dynamic>{};
  for (final r in rows) {
  var arr = (byVol.get(r.volunteerName) ?? []);
  arr.add(r);
  byVol.set(r.volunteerName, arr);
}
  var out = [];
  for (final undefined in byVol) {
  out.add('🦺 ${volName} (${list.length} מסירות)');
  for (final r in list) {
  out.add('  • ${r.familyName} · ${statusLabel(r.status)}' + (r.address ? ' · 📍 ' + r.address : '') + (r.note ? ' · ' + r.note : ''));
}
}
  return out;
}
