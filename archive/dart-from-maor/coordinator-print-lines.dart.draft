dynamic coordinatorPrintLines(dynamic db, dynamic coordinatorId, dynamic config, dynamic termOf, dynamic coordinatorBoxes, dynamic lastCollectionIso) {
  dynamic T(dynamic k, dynamic fb) => (config ? termOf(config, k, fb) : fb);
  var coord = db.tzCoordinators.firstWhere((c) => c.id == coordinatorId);
  var boxes = coordinatorBoxes(db.tzBoxes, coordinatorId).where((b) => (b.status == 'home' || b.status == 'office'));
  var lines = ['רשימת קופות — ' + ((coord.name ?? '')), '='._repeat(30)];
  for (final b in boxes) {
  var fam = db.families.firstWhere((f) => f.id == b.famId);
  var last = lastCollectionIso(b);
  lines.add(['#' + b.num, fam ? T('entity.familyOf', 'משפחת') + ' ' + fam.name : 'במשרד', fam ? [fam.address, fam.city].where(Boolean).join(', ') : '', (fam.phone ?? ''), last ? 'ריקון אחרון: ' + last : 'טרם רוקנה'].where(Boolean).join(' · '));
}
  if (boxes.length == 0) lines.add('אין קופות פעילות');
  return lines;
}
