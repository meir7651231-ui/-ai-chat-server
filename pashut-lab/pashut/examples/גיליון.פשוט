# גיליון — אקסל קטן, כתוב כולו בעברית.   בונים:  python3 pashut.py examples/גיליון.פשוט --אתר
# בכל משבצת: מספר, טקסט, או נוסחה שמתחילה ב-=
#   =B2*C2      =סכום(D2:D5)      =ממוצע(B2:B5)      =(B2+B3)/2      =הגדול(C2:C5)
# מה יש כאן: מפרק נוסחאות, מחשב לפי סדר פעולות, עוקב אחרי תאים שתלויים בתאים אחרים,
# ומזהה מעגל (תא שתלוי בעצמו), חלוקה באפס ותא שלא קיים.

שורות = 9
עמודות = 5
אותיות = "ABCDE"
ספרות = "0123456789"

כותרת("גיליון")
טקסט_בדף("כתוב מספר, מילה, או נוסחה שמתחילה ב-= (למשל =B2*C2 או =סכום(D2:D5)). הלוח התחתון מתעדכן לבד.")
גיליון = לוח(שורות + 1, עמודות + 1, חשב_הכל)
טקסט_בדף("התוצאות:")
תוצאות = לוח(שורות + 1, עמודות + 1)
מצב = טקסט_בדף("")

# ---------- כתובת של תא: "B3" -> (שורה 3, עמודה 2) ----------
פעולה עמודה_של(כתובת: טקסט):
    תן אותיות.מצא(כתובת[0]) + 1

פעולה שורה_של(כתובת: טקסט):
    תן מספר(כתובת[1:])

פעולה כתובת_תקינה(ט: טקסט):
    אם כמה(ט) < 2 או אותיות.מצא(ט[0]) < 0:
        תן לא נכון
    לכל ס בתוך ט[1:]:
        אם ס לא בתוך ספרות:
            תן לא נכון
    ש = מספר(ט[1:])
    תן ש >= 1 וגם ש <= שורות

# ---------- פירוק נוסחה לחלקים: "=סכום(B2:B5)*2" -> [סכום, (, B2, :, B5, ), *, 2] ----------
פעולה פרק(נוסחה: טקסט):
    חלקים = []
    נוכחי = ""
    לכל ס בתוך נוסחה:
        אם ס בתוך "+-*/():,":
            אם נוכחי != "":
                חלקים.הוסף(נוכחי)
                נוכחי = ""
            חלקים.הוסף(ס)
        ואם ס == " ":
            אם נוכחי != "":
                חלקים.הוסף(נוכחי)
                נוכחי = ""
        אחרת:
            נוכחי = נוכחי + ס
    אם נוכחי != "":
        חלקים.הוסף(נוכחי)
    תן חלקים

# ---------- מחשב נוסחה ("חיפוש יורד": ביטוי -> איבר -> גורם) ----------
מבנה מנתח:
    חלקים: רשימה של טקסט
    מקום: מספר = 0

    פעולה נוכחי():
        אם זה.מקום < כמה(זה.חלקים):
            תן זה.חלקים[זה.מקום]
        תן ""

    פעולה קח(מה: טקסט):
        אם זה.נוכחי() != מה:
            שגיאה("#נוסחה!")
        זה.מקום += 1

    פעולה ביטוי():
        ערך = זה.איבר()
        כל עוד זה.נוכחי() == "+" או זה.נוכחי() == "-":
            פעולה_ = זה.נוכחי()
            זה.מקום += 1
            אם פעולה_ == "+":
                ערך = ערך + זה.איבר()
            אחרת:
                ערך = ערך - זה.איבר()
        תן ערך

    פעולה איבר():
        ערך = זה.גורם()
        כל עוד זה.נוכחי() == "*" או זה.נוכחי() == "/":
            פעולה_ = זה.נוכחי()
            זה.מקום += 1
            אם פעולה_ == "*":
                ערך = ערך * זה.גורם()
            אחרת:
                מחלק = זה.גורם()
                אם מחלק == 0.0:
                    שגיאה("#חלוקה!")
                ערך = ערך / מחלק
        תן ערך

    פעולה גורם():
        ח = זה.נוכחי()
        אם ח == "":
            שגיאה("#נוסחה!")
        אם ח == "-":
            זה.מקום += 1
            תן -זה.גורם()
        אם ח == "(":
            זה.מקום += 1
            ערך = זה.ביטוי()
            זה.קח(")")
            תן ערך
        אם ח[0] בתוך ספרות:
            זה.מקום += 1
            נסה:
                תן שבר(ח)
            אם נכשל:
                שגיאה("#נוסחה!")
        אם כתובת_תקינה(ח):
            זה.מקום += 1
            תן ערך_של(ח)
        # פעולה על טווח: סכום(B2:B5), ממוצע, הגדול, הקטן
        זה.מקום += 1
        זה.קח("(")
        ערכים = זה.טווח()
        זה.קח(")")
        אם ח == "סכום":
            תן סכום(ערכים)
        אם כמה(ערכים) == 0:
            שגיאה("#ריק!")
        אם ח == "ממוצע":
            תן סכום(ערכים) / כמה(ערכים)
        אם ח == "הגדול":
            תן הגדול(ערכים)
        אם ח == "הקטן":
            תן הקטן(ערכים)
        שגיאה("#שם?")

    פעולה טווח():
        מ = זה.נוכחי()
        זה.מקום += 1
        אם לא כתובת_תקינה(מ):
            שגיאה("#נוסחה!")
        עד = מ
        אם זה.נוכחי() == ":":
            זה.מקום += 1
            עד = זה.נוכחי()
            זה.מקום += 1
            אם לא כתובת_תקינה(עד):
                שגיאה("#נוסחה!")
        ערכים = [0.0]
        ערכים.הוצא()
        לכל ש בתוך ספירה(הקטן(שורה_של(מ), שורה_של(עד)), הגדול(שורה_של(מ), שורה_של(עד)) + 1):
            לכל ע בתוך ספירה(הקטן(עמודה_של(מ), עמודה_של(עד)), הגדול(עמודה_של(מ), עמודה_של(עד)) + 1):
                ערכים.הוסף(ערך_של(אותיות[ע - 1] + טקסט(ש)))
        תן ערכים

# ---------- הערך של תא (עם זיכרון, ועם זיהוי מעגל) ----------
ערכים_ידועים = {"": 0.0}
שגיאות_ידועות = {"": ""}
בחישוב = {"": לא נכון}

פעולה ערך_של(כתובת: טקסט):
    אם כתובת בתוך ערכים_ידועים:
        תן ערכים_ידועים[כתובת]
    אם כתובת בתוך שגיאות_ידועות:
        שגיאה(שגיאות_ידועות[כתובת])
    אם בחישוב.קבל(כתובת, לא נכון):
        שגיאה("#מעגל!")
    בחישוב[כתובת] = נכון
    תוכן = גיליון.קרא(שורה_של(כתובת), עמודה_של(כתובת))
    נסה:
        אם תוכן == "":
            ערך = 0.0
        ואם תוכן[0] == "=":
            מ = מנתח(פרק(תוכן[1:]))
            ערך = מ.ביטוי()
            אם מ.נוכחי() != "":
                שגיאה("#נוסחה!")
        אחרת:
            נסה:
                ערך = שבר(תוכן)
            אם נכשל:
                שגיאה("#ערך!")          # נוסחה שמשתמשת בתא עם מילה
    אם נכשל עם הודעה:
        בחישוב[כתובת] = לא נכון
        אם לא הודעה.מתחיל_ב("#"):
            הודעה = "#שגיאה!"
        שגיאות_ידועות[כתובת] = הודעה
        שגיאה(הודעה)
    בחישוב[כתובת] = לא נכון
    ערכים_ידועים[כתובת] = ערך
    תן ערך

פעולה יפה(x: שבר):
    אם x == שבר(עגל(x)) וגם חיובי(x) < 1000000000000000.0:
        תן טקסט(עגל(x))
    תן טקסט(עגל(x, 4))

פעולה חשב_הכל():
    # מתחילים מחדש: שוכחים כל מה שחושב קודם
    לכל מפתח בתוך מפתחות(ערכים_ידועים):
        ערכים_ידועים.הוצא(מפתח)
    לכל מפתח בתוך מפתחות(שגיאות_ידועות):
        שגיאות_ידועות.הוצא(מפתח)
    לכל מפתח בתוך מפתחות(בחישוב):
        בחישוב.הוצא(מפתח)
    נוסחאות = 0
    בעיות = 0
    לכל ש בתוך ספירה(1, שורות + 1):
        לכל ע בתוך ספירה(1, עמודות + 1):
            תוכן = גיליון.קרא(ש, ע)
            תוצאה = תוכן
            אם תוכן != "" וגם תוכן[0] == "=":
                נוסחאות += 1
                נסה:
                    תוצאה = יפה(ערך_של(אותיות[ע - 1] + טקסט(ש)))
                אם נכשל עם הודעה:
                    תוצאה = הודעה
                    בעיות += 1
            תוצאות.קבע(ש, ע, תוצאה)
            תוצאות.סמן(ש, ע, תוכן != "" וגם תוכן[0] == "=")
    אם בעיות == 0:
        מצב.שנה(טקסט(נוסחאות) + " נוסחאות חושבו, בלי שגיאות.")
    אחרת:
        מצב.שנה(טקסט(נוסחאות) + " נוסחאות חושבו. ב-" + טקסט(בעיות) + " מהן יש בעיה (מסומן ב-#).")

# ---------- כותרות ודוגמה ----------
לכל ע בתוך ספירה(1, עמודות + 1):
    גיליון.קבע(0, ע, אותיות[ע - 1])
    תוצאות.קבע(0, ע, אותיות[ע - 1])
לכל ש בתוך ספירה(1, שורות + 1):
    גיליון.קבע(ש, 0, טקסט(ש))
    תוצאות.קבע(ש, 0, טקסט(ש))
לכל ש בתוך ספירה(0, שורות + 1):
    לכל ע בתוך ספירה(0, עמודות + 1):
        תוצאות.נעל(ש, ע)
        אם ש == 0 או ע == 0:
            גיליון.נעל(ש, ע)

דוגמה = [["פריט", "מחיר", "כמות", "סה\"כ", "אחוז"],
         ["לחם", "8.5", "2", "=B2*C2", "=D2/D7*100"],
         ["חלב", "6.9", "3", "=B3*C3", "=D3/D7*100"],
         ["גבינה", "24", "1", "=B4*C4", "=D4/D7*100"],
         ["ביצים", "14", "2", "=B5*C5", "=D5/D7*100"],
         ["", "", "", "", ""],
         ["לתשלום", "", "=סכום(C2:C5)", "=סכום(D2:D5)", "=סכום(E2:E5)"],
         ["ממוצע", "=ממוצע(B2:B5)", "", "=ממוצע(D2:D5)", ""],
         ["יקר ביותר", "=הגדול(B2:B5)", "", "=הגדול(D2:D5)", ""]]
לכל ש בתוך ספירה(כמה(דוגמה)):
    לכל ע בתוך ספירה(עמודות):
        גיליון.קבע(ש + 1, ע + 1, דוגמה[ש][ע])
חשב_הכל()
