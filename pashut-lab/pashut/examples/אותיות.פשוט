# אותיות — רשת נוירונים שלומדת לקרוא אותיות עבריות מתמונה.
#
# היא מקבלת תמונה קטנה (16 על 16 נקודות) ואת שם האות. אף אחד לא אומר לה
# "לאלף יש קו אלכסוני" — היא מוצאת לבד מה מבדיל בין האותיות.
# בסוף בודקים אותה על גופן שהיא אף פעם לא ראתה.
#
# הרשת: 256 כניסות (נקודה לכל פיקסל) ← 48 נוירונים ← 22 יציאות (אחת לכל אות).

זרע(3)
אותיות = "אבגדהוזחטיכלמנסעפצקרשת"
פיקסלים = 256
נסתרים = 96
יציאות = 22
קצב = [0.05]                                 # גודל הצעד בלמידה — קטן עם הזמן

מבנה דוגמה:
    אות: מספר
    תמונה: רשימה של שבר

פעולה טען(שם_קובץ):
    דוגמאות = []
    לכל שורה בתוך קרא_קובץ(שם_קובץ).שורות():
        אם שורה == "":
            הבא
        חלקים = שורה.פצל(" ")
        תמונה = []
        לכל נקודה בתוך חלקים[1]:
            אם נקודה == "1":
                תמונה.הוסף(1.0)
            אחרת:
                תמונה.הוסף(0.0)
        דוגמאות.הוסף(דוגמה(אותיות.מצא(חלקים[0]), תמונה))
    תן דוגמאות

פעולה משקלים_אקראיים(שורות, עמודות, גודל: שבר):
    מ = []
    לכל i בתוך ספירה(שורות):
        שורה = []
        לכל j בתוך ספירה(עמודות + 1):          # +1 = "הטיה" (bias)
            שורה.הוסף((אקראי() - 0.5) * 2.0 * גודל)
        מ.הוסף(שורה)
    תן מ

W1 = משקלים_אקראיים(נסתרים, פיקסלים, 0.1)
W2 = משקלים_אקראיים(יציאות, נסתרים, 0.3)

פעולה טנה(x: שבר):
    אם x > 20.0:
        תן 1.0
    אם x < -20.0:
        תן -1.0
    e = אקספ(2.0 * x)
    תן (e - 1.0) / (e + 1.0)

פעולה נסתר_של(x: רשימה של שבר):
    h = []
    לכל w בתוך W1:
        s = w[פיקסלים]
        לכל i בתוך ספירה(פיקסלים):
            אם x[i] > 0.0:                     # פיקסל ריק לא תורם כלום — מדלגים
                s += w[i]
        h.הוסף(טנה(s))
    תן h

פעולה הסתברויות_של(h: רשימה של שבר):
    z = []
    לכל w בתוך W2:
        s = w[נסתרים]
        לכל j בתוך ספירה(נסתרים):
            s += w[j] * h[j]
        z.הוסף(s)
    גבוה = הגדול(z)
    ex = []
    לכל ערך בתוך z:
        ex.הוסף(אקספ(ערך - גבוה))
    סך = סכום(ex)
    p = []
    לכל ערך בתוך ex:
        p.הוסף(ערך / סך)
    תן p

פעולה נחש(x: רשימה של שבר):
    p = הסתברויות_של(נסתר_של(x))
    הכי = 0
    לכל o בתוך ספירה(יציאות):
        אם p[o] > p[הכי]:
            הכי = o
    תן הכי

# ---------- ללמוד מדוגמה אחת ----------
פעולה למד(ד: דוגמה):
    x = ד.תמונה
    h = נסתר_של(x)
    p = הסתברויות_של(h)
    g = []                                     # כמה כל יציאה טעתה
    לכל o בתוך ספירה(יציאות):
        אם o == ד.אות:
            g.הוסף(1.0 - p[o])
        אחרת:
            g.הוסף(0.0 - p[o])
    gh = []
    לכל j בתוך ספירה(נסתרים):
        s = 0.0
        לכל o בתוך ספירה(יציאות):
            s += g[o] * W2[o][j]
        gh.הוסף(s * (1.0 - h[j] * h[j]))
    לכל o בתוך ספירה(יציאות):
        w = W2[o]
        k = קצב[0] * g[o]
        לכל j בתוך ספירה(נסתרים):
            w[j] += k * h[j]
        w[נסתרים] += k
    לכל j בתוך ספירה(נסתרים):
        w = W1[j]
        k = קצב[0] * gh[j]
        לכל i בתוך ספירה(פיקסלים):
            אם x[i] > 0.0:
                w[i] += k
        w[פיקסלים] += k

פעולה אחוז(דוגמאות: רשימה של דוגמה):
    נכון_ = 0
    לכל ד בתוך דוגמאות:
        אם נחש(ד.תמונה) == ד.אות:
            נכון_ += 1
    תן 100 * נכון_ // כמה(דוגמאות)

פעולה צייר(ד: דוגמה):
    לכל r בתוך ספירה(16):
        שורה = ""
        לכל c בתוך ספירה(16):
            אם ד.תמונה[r * 16 + c] > 0.0:
                שורה += "█"
            אחרת:
                שורה += "·"
        הצג("      " + שורה)

אימון = טען("letters/אימון.txt")
מבחן = טען("letters/מבחן.txt")
נקי = טען("letters/מבחן_נקי.txt")
הצג("תמונות לאימון:", כמה(אימון), "   תמונות מגופן שהיא לא ראתה:", כמה(מבחן))
הצג("לפני שלמדה — מזהה בגופן החדש:", טקסט(אחוז(מבחן)) + "%  (ניחוש עיוור = 4%)")
הצג("")

לכל סבב בתוך ספירה(1, 16):
    # מערבבים את סדר התמונות בכל סבב
    לכל i בתוך ספירה(כמה(אימון) - 1, 0, -1):
        j = מספר(אקראי() * שבר(i + 1))
        זמני = אימון[i]
        אימון[i] = אימון[j]
        אימון[j] = זמני
    לכל ד בתוך אימון:
        למד(ד)
    קצב[0] = קצב[0] * 0.8
    הצג("   סבב", סבב, ": מזהה באימון", טקסט(אחוז(אימון)) + "%,", "בגופן שלא ראתה", טקסט(אחוז(מבחן)) + "%")

הצג("")
הצג("דוגמאות מהגופן שהיא לא ראתה אף פעם:")
לכל n בתוך [3, 58, 121, 187]:
    ד = מבחן[n]
    נ = נחש(ד.תמונה)
    הצג("")
    צייר(ד)
    סימן = "✗ טעתה"
    אם נ == ד.אות:
        סימן = "✓"
    הצג("      היא אומרת:", אותיות[נ], "  (באמת:", אותיות[ד.אות] + ")", סימן)

הצג("")
הצג("בגופנים שלא ראתה, בתמונות נקיות (בלי רעש ובלי עיבוי/הקטנה של הקו):", טקסט(אחוז(נקי)) + "%")
