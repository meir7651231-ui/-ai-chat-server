# לומד — מכונה שלומדת לבד לכתוב תוכניות קטנות, מניסיון.
#
# המשימה: לכתוב תוכנית (רצף פקודות +1, ×2, −1) שמתחילה ב-1 ומגיעה למספר מטרה.
# אף אחד לא אומר לה איך. היא מנסה, "שופט" מריץ את התוכנית ובודק, והיא משתפרת.
# בסוף בודקים אותה על מספרים שהיא אף פעם לא ראתה באימון.
#
# בפנים: רשת נוירונים (11 כניסות, 24 נוירונים נסתרים, 3 יציאות), ולמידה מניסיון
# (REINFORCE: מה שהצליח — מחזקים; מה שנכשל — מחלישים). הכל כתוב כאן, בלי ספריות.

זרע(7)
פקודות = ["+1", "×2", "−1"]
מקסימום_צעדים = 20
כניסות = 11
נסתרים = 24
יציאות = 3
קצב_למידה = 0.02

# ---------- השופט: מריץ תוכנית ובודק ----------
פעולה הפעל(ערך, פקודה):
    אם פקודה == 0:
        תן ערך + 1
    ואם פקודה == 1:
        תן ערך * 2
    תן ערך - 1

# ---------- מה הרשת "רואה" בכל צעד ----------
פעולה לוגי_לשבר(ב: לוגי):
    אם ב:
        תן 1.0
    תן 0.0

פעולה תכונות(ערך, מטרה, נשארו):
    תן [שבר(ערך) / 32.0, שבר(מטרה) / 32.0, שבר(מטרה - ערך) / 32.0,
        לוגי_לשבר(מטרה >= 2 * ערך), לוגי_לשבר(מטרה % 2 == 0), שבר(נשארו) / 20.0,
        לוגי_לשבר(מטרה - ערך == 1), לוגי_לשבר(מטרה == 2 * ערך), 1.0,
        לוגי_לשבר(מטרה > ערך), לוגי_לשבר(מטרה < ערך)]

# ---------- הרשת ----------
פעולה טנה(x: שבר):
    אם x > 20.0:
        תן 1.0
    אם x < -20.0:
        תן -1.0
    e = אקספ(2.0 * x)
    תן (e - 1.0) / (e + 1.0)

פעולה משקלים_אקראיים(שורות, עמודות):
    מ = []
    לכל i בתוך ספירה(שורות):
        שורה = []
        לכל j בתוך ספירה(עמודות):
            שורה.הוסף((אקראי() - 0.5) * 1.6)
        מ.הוסף(שורה)
    תן מ

W1 = משקלים_אקראיים(נסתרים, כניסות)
W2 = משקלים_אקראיים(יציאות, נסתרים)

מבנה צעד:
    כניסה: רשימה של שבר
    נסתר: רשימה של שבר
    הסתברויות: רשימה של שבר
    בחירה: מספר

פעולה חשב_נסתר(x: רשימה של שבר):
    h = []
    לכל שורה בתוך W1:
        s = 0.0
        לכל i בתוך ספירה(כניסות):
            s += שורה[i] * x[i]
        h.הוסף(טנה(s))
    תן h

פעולה חשב_הסתברויות(h: רשימה של שבר):
    z = []
    לכל שורה בתוך W2:
        s = 0.0
        לכל j בתוך ספירה(נסתרים):
            s += שורה[j] * h[j]
        z.הוסף(s)
    גבוה = הגדול(z)
    ex = []
    לכל ערך בתוך z:
        ex.הוסף(אקספ(ערך - גבוה))
    סך = סכום(ex)
    p = []
    לכל ערך בתוך ex:
        p.הוסף(ערך / סך)
    תן p

פעולה בחר(p: רשימה של שבר, חמדן: לוגי):
    אם חמדן:
        הכי = 0
        לכל i בתוך ספירה(יציאות):
            אם p[i] > p[הכי]:
                הכי = i
        תן הכי
    r = אקראי()
    לכל i בתוך ספירה(יציאות):
        r -= p[i]
        אם r < 0.0:
            תן i
    תן יציאות - 1

# ---------- ניסיון אחד: הרשת כותבת תוכנית, השופט בודק ----------
מבנה ניסיון:
    צעדים: רשימה של צעד
    הצליח: לוגי
    תוכנית: טקסט

פעולה נסה_לכתוב(מטרה, חמדן: לוגי):
    ערך = 1
    צעדים = []
    תוכנית = []
    לכל s בתוך ספירה(מקסימום_צעדים):
        x = תכונות(ערך, מטרה, מקסימום_צעדים - s)
        h = חשב_נסתר(x)
        p = חשב_הסתברויות(h)
        a = בחר(p, חמדן)
        צעדים.הוסף(צעד(x, h, p, a))
        תוכנית.הוסף(פקודות[a])
        ערך = הפעל(ערך, a)
        אם ערך == מטרה או ערך > 64 או ערך < 0:
            עצור
    תן ניסיון(צעדים, ערך == מטרה, " ".חבר(תוכנית))

# ---------- למידה מניסיון ----------
ממוצע_פרס = [0.0]

פעולה למד(מטרה):
    נ = נסה_לכתוב(מטרה, לא נכון)
    פרס = 0.0
    אם נ.הצליח:
        פרס = 1.0 - 0.03 * כמה(נ.צעדים)          # הצלחה — וקצר יותר, עדיף
    ממוצע_פרס[0] = 0.99 * ממוצע_פרס[0] + 0.01 * פרס
    יתרון = פרס - ממוצע_פרס[0]                   # יותר טוב מהרגיל? מחזקים. פחות? מחלישים.
    לכל צ בתוך נ.צעדים:
        g = []
        לכל o בתוך ספירה(יציאות):
            אם o == צ.בחירה:
                g.הוסף(1.0 - צ.הסתברויות[o])
            אחרת:
                g.הוסף(0.0 - צ.הסתברויות[o])
        gh = []
        לכל j בתוך ספירה(נסתרים):
            s = 0.0
            לכל o בתוך ספירה(יציאות):
                s += g[o] * W2[o][j]
            gh.הוסף(s * (1.0 - צ.נסתר[j] * צ.נסתר[j]))
        לכל o בתוך ספירה(יציאות):
            לכל j בתוך ספירה(נסתרים):
                W2[o][j] += קצב_למידה * יתרון * g[o] * צ.נסתר[j]
        לכל j בתוך ספירה(נסתרים):
            לכל i בתוך ספירה(כניסות):
                W1[j][i] += קצב_למידה * יתרון * gh[j] * צ.כניסה[i]

# ---------- מבחן ----------
אימון = []
מבחן = []
לכל t בתוך ספירה(2, 41):
    אם t % 5 == 0:
        מבחן.הוסף(t)          # את אלה היא לא תראה אף פעם באימון
    אחרת:
        אימון.הוסף(t)

פעולה אחוז_הצלחה(מטרות: רשימה של מספר):
    הצליחו = 0
    לכל t בתוך מטרות:
        אם נסה_לכתוב(t, נכון).הצליח:
            הצליחו += 1
    תן 100 * הצליחו // כמה(מטרות)

פעולה הראה_דוגמאות():
    לכל t בתוך [10, 25, 35, 40]:
        נ = נסה_לכתוב(t, נכון)
        סימן = "✗"
        אם נ.הצליח:
            סימן = "✓"
        הצג("   ", סימן, "להגיע ל-" + טקסט(t) + ":", נ.תוכנית)

הצג("לפני האימון (הרשת לא יודעת כלום):")
הצג("   הצלחה על מספרים חדשים:", טקסט(אחוז_הצלחה(מבחן)) + "%")
הראה_דוגמאות()
הצג("")
הצג("מתאמנת... (כל שורה = עוד ניסיונות)")
לכל סבב בתוך ספירה(1, 40001):
    למד(אימון[מספר(אקראי() * שבר(כמה(אימון)))])
    אם סבב % 5000 == 0:
        הצג("   אחרי", סבב, "ניסיונות: אימון", טקסט(אחוז_הצלחה(אימון)) + "%,", "מספרים חדשים", טקסט(אחוז_הצלחה(מבחן)) + "%")
הצג("")
הצג("אחרי האימון — על מספרים שהיא אף פעם לא ראתה:")
הראה_דוגמאות()
