# רשימת קניות — דף אינטרנט.   בונים:  python3 pashut.py examples/קניות.פשוט --אתר
כותרת("רשימת קניות")
הסבר = טקסט_בדף("כתוב מה לקנות ולחץ Enter או \"הוסף\". הרשימה נשמרת בדפדפן.")

פריטים = []
אם קיים_קובץ("קניות"):
    לכל שורה בתוך קרא_קובץ("קניות").שורות():
        פריטים.הוסף(שורה)
אחרת:
    פריטים = ["חלב", "לחם", "ביצים"]      # דוגמה, בפעם הראשונה

שדה = שדה_קלט("למשל: חלב", הוסף_פריט)
כפתור("הוסף", הוסף_פריט)
כפתור("נקה הכל", נקה_הכל)
מונה = טקסט_בדף("")
רשימה = רשימת_שורות()

פעולה הצג_הכל():
    רשימה.נקה()
    לכל פ בתוך פריטים:
        רשימה.הוסף(פ)
    אם כמה(פריטים) == 0:
        מונה.שנה("הרשימה ריקה")
    אחרת:
        מונה.שנה("יש " + טקסט(כמה(פריטים)) + " פריטים")
    כתוב_קובץ("קניות", "\n".חבר(פריטים))

פעולה הוסף_פריט():
    מה = שדה.ערך().נקה()
    אם מה == "":
        תן
    אם מה בתוך פריטים:
        מונה.שנה("\"" + מה + "\" כבר ברשימה")
        תן
    פריטים.הוסף(מה)
    שדה.נקה()
    הצג_הכל()

פעולה נקה_הכל():
    כל עוד כמה(פריטים) > 0:
        פריטים.הוצא()
    הצג_הכל()

הצג_הכל()
