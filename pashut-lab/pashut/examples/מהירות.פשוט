# בדיקת מהירות: רקורסיה, לולאה גדולה, וחשבון עם שברים
פעולה פיב(n):
    אם n < 2:
        תן n
    תן פיב(n - 1) + פיב(n - 2)

הצג("פיבונאצ'י של 30:", פיב(30))

סכום = 0
לכל i בתוך ספירה(30000000):
    אם i % 3 == 0 או i % 5 == 0:
        סכום += i
הצג("סכום המספרים שמתחלקים ב-3 או ב-5:", סכום)

פאי = 0.0
סימן = 1.0
לכל k בתוך ספירה(10000000):
    פאי += סימן / (2 * k + 1)
    סימן = -סימן
הצג("פאי בקירוב:", פאי * 4)
