# עיניים — רשת שמסתכלת על צורות קטנות, לא על נקודות בודדות.
#
# לרשת יש 12 "עיניים" קטנות (כל אחת רואה ריבוע של 5 על 5 נקודות).
# כל עין עוברת על כל התמונה ומחפשת צורה אחת — קו, פינה, קשת. איזו צורה?
# אף אחד לא אומר לה. כל עין מגלה לבד איזו צורה כדאי לה לחפש.
# אחר כך: איפה בערך נמצאה כל צורה ← ומזה — איזו אות זו.

זרע(3)
אותיות = "אבגדהוזחטיכלמנסעפצקרשת"
עיניים = 12          # כמה צורות היא מחפשת
ע = 5                # גודל העין
רוחב = 24             # גודל התמונה: 24 על 24 נקודות
מפה = 20             # 24 - 5 + 1 : בכמה מקומות אפשר לשים עין
חצי = 10             # אחרי "כיווץ" 2 על 2
מאפיינים = עיניים * חצי * חצי
יציאות = 22
קצב = [0.03]

מבנה דוגמה:
    אות: מספר
    תמונה: רשימה של שבר

פעולה טען(שם_קובץ):
    דוגמאות = []
    לכל שורה בתוך קרא_קובץ(שם_קובץ).שורות():
        אם שורה == "":
            הבא
        חלקים = שורה.פצל(" ")
        תמונה = []
        לכל נקודה בתוך חלקים[1]:
            אם נקודה == "1":
                תמונה.הוסף(1.0)
            אחרת:
                תמונה.הוסף(0.0)
        דוגמאות.הוסף(דוגמה(אותיות.מצא(חלקים[0]), תמונה))
    תן דוגמאות

פעולה אקראיים(n, גודל: שבר):
    r = []
    לכל i בתוך ספירה(n):
        r.הוסף((אקראי() - 0.5) * 2.0 * גודל)
    תן r

עין = אקראיים(עיניים * ע * ע, 0.3)              # מה כל עין מחפשת
הטיית_עין = אקראיים(עיניים, 0.1)
W = אקראיים(יציאות * מאפיינים, 0.1)           # מצורות לאותיות
הטיה = אקראיים(יציאות, 0.0)

פעולה טנה(x: שבר):
    אם x > 20.0:
        תן 1.0
    אם x < -20.0:
        תן -1.0
    e = אקספ(2.0 * x)
    תן (e - 1.0) / (e + 1.0)

מבנה מבט:
    מפות: רשימה של שבר        # כמה חזק כל עין "ראתה" את הצורה שלה בכל מקום
    מאפיינים: רשימה של שבר    # אחרי כיווץ
    איפה: רשימה של מספר       # איזה מקום ניצח בכל כיווץ
    הסתברויות: רשימה של שבר

פעולה הסתכל(x: רשימה של שבר):
    מפות = []
    לכל f בתוך ספירה(עיניים):
        בסיס = f * ע * ע
        לכל i בתוך ספירה(מפה):
            לכל j בתוך ספירה(מפה):
                s = הטיית_עין[f]
                לכל u בתוך ספירה(ע):
                    שורה = (i + u) * רוחב + j
                    לכל v בתוך ספירה(ע):
                        s += עין[בסיס + u * ע + v] * x[שורה + v]
                מפות.הוסף(טנה(s))
    מאפ = []
    איפה = []
    לכל f בתוך ספירה(עיניים):
        לכל i בתוך ספירה(חצי):
            לכל j בתוך ספירה(חצי):
                הכי = f * מפה * מפה + (2 * i) * מפה + 2 * j
                לכל צד בתוך [1, מפה, מפה + 1]:          # שלושת השכנים בריבוע 2 על 2
                    k = f * מפה * מפה + (2 * i) * מפה + 2 * j + צד
                    אם מפות[k] > מפות[הכי]:
                        הכי = k
                מאפ.הוסף(מפות[הכי])
                איפה.הוסף(הכי)
    z = []
    לכל o בתוך ספירה(יציאות):
        s = הטיה[o]
        בסיס = o * מאפיינים
        לכל k בתוך ספירה(מאפיינים):
            s += W[בסיס + k] * מאפ[k]
        z.הוסף(s)
    גבוה = הגדול(z)
    ex = []
    לכל ערך בתוך z:
        ex.הוסף(אקספ(ערך - גבוה))
    סך = סכום(ex)
    p = []
    לכל ערך בתוך ex:
        p.הוסף(ערך / סך)
    תן מבט(מפות, מאפ, איפה, p)

פעולה נחש(x: רשימה של שבר):
    p = הסתכל(x).הסתברויות
    הכי = 0
    לכל o בתוך ספירה(יציאות):
        אם p[o] > p[הכי]:
            הכי = o
    תן הכי

פעולה למד(ד: דוגמה):
    x = ד.תמונה
    מ = הסתכל(x)
    g = []
    לכל o בתוך ספירה(יציאות):
        אם o == ד.אות:
            g.הוסף(1.0 - מ.הסתברויות[o])
        אחרת:
            g.הוסף(0.0 - מ.הסתברויות[o])
    # כמה כל מאפיין אשם
    dm = []
    לכל k בתוך ספירה(מאפיינים):
        dm.הוסף(0.0)
    לכל o בתוך ספירה(יציאות):
        בסיס = o * מאפיינים
        לכל k בתוך ספירה(מאפיינים):
            dm[k] += g[o] * W[בסיס + k]
    לכל o בתוך ספירה(יציאות):
        בסיס = o * מאפיינים
        צעד = קצב[0] * g[o]
        לכל k בתוך ספירה(מאפיינים):
            W[בסיס + k] += צעד * מ.מאפיינים[k]
        הטיה[o] += צעד
    # מחזירים את האשמה לעין, רק דרך המקום שניצח
    לכל k בתוך ספירה(מאפיינים):
        מקום = מ.איפה[k]
        a = מ.מפות[מקום]
        d = dm[k] * (1.0 - a * a) * קצב[0]
        f = מקום // (מפה * מפה)
        שארית = מקום % (מפה * מפה)
        i = שארית // מפה
        j = שארית % מפה
        בסיס = f * ע * ע
        לכל u בתוך ספירה(ע):
            שורה = (i + u) * רוחב + j
            לכל v בתוך ספירה(ע):
                עין[בסיס + u * ע + v] += d * x[שורה + v]
        הטיית_עין[f] += d

פעולה אחוז(דוגמאות: רשימה של דוגמה):
    נכון_ = 0
    לכל ד בתוך דוגמאות:
        אם נחש(ד.תמונה) == ד.אות:
            נכון_ += 1
    תן 100 * נכון_ // כמה(דוגמאות)

אימון = טען("letters/אימון24.txt")
מבחן = טען("letters/מבחן24.txt")
נקי = טען("letters/מבחן24_נקי.txt")
הצג("תמונות לאימון:", כמה(אימון), "   תמונות מגופנים שהיא לא ראתה:", כמה(מבחן))
הצג("לפני שלמדה — בגופנים החדשים:", טקסט(אחוז(מבחן)) + "%")
הצג("")
לכל סבב בתוך ספירה(1, 13):
    לכל i בתוך ספירה(כמה(אימון) - 1, 0, -1):
        j = מספר(אקראי() * שבר(i + 1))
        זמני = אימון[i]
        אימון[i] = אימון[j]
        אימון[j] = זמני
    לכל ד בתוך אימון:
        למד(ד)
    קצב[0] = קצב[0] * 0.8
    הצג("   סבב", סבב, ": בגופנים שלא ראתה", טקסט(אחוז(מבחן)) + "%")

# מה העיניים למדו לחפש
הצג("")
הצג("מה 4 מהעיניים למדו לחפש לבד (█ = חשוב שיהיה דיו, · = חשוב שיהיה ריק):")
לכל u בתוך ספירה(ע):
    שורה = ""
    לכל f בתוך ספירה(4):
        לכל v בתוך ספירה(ע):
            w = עין[f * ע * ע + u * ע + v]
            אם w > 0.15:
                שורה += "█"
            ואם w < -0.15:
                שורה += "·"
            אחרת:
                שורה += " "
        שורה += "     "
    הצג("      " + שורה)

הצג("")
הצג("בגופנים שלא ראתה, בתמונות נקיות (בלי רעש ובלי עיבוי/הקטנה של הקו):", טקסט(אחוז(נקי)) + "%")
