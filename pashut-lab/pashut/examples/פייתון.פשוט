# שימוש בספריות של Python מתוך "פשוט"
ייבא json
ייבא statistics
ייבא datetime

ציונים = [90, 85, 77, 62, 100]
הצג("ממוצע:", statistics.mean(ציונים), " חציון:", statistics.median(ציונים))
הצג("סטיית תקן:", עגל(שבר(statistics.stdev(ציונים)), 2))

נתונים = json.loads("{\"שם\": \"דנה\", \"ציונים\": [90, 95]}")
הצג("שם:", נתונים["שם"], " כמה ציונים:", כמה(נתונים["ציונים"]))
סך = 0
לכל צ בתוך נתונים["ציונים"]:
    סך += מספר(צ)
הצג("סכום:", סך)

יום = datetime.date(2026, 9, 28)
הצג("יום בשבוע (0=שני):", יום.weekday(), " בעוד 100 יום:", יום + datetime.timedelta(days=100))

