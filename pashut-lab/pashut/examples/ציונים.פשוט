# ציונים — ממוצע והערכה לכל ציון
פעולה ממוצע(סך, מספר_ציונים):
    אם מספר_ציונים == 0:
        תן 0.0
    תן סך / מספר_ציונים

סך = 0
מספר_ציונים = 0
לכל ציון בתוך ספירה(50, 101, 15):
    סך += ציון
    מספר_ציונים += 1
    אם ציון >= 85:
        הצג("מצוין:", ציון)
    ואם ציון >= 60:
        הצג("עבר:", ציון)
    אחרת:
        הצג("נכשל:", ציון)

הצג("הממוצע:", ממוצע(סך, מספר_ציונים))
הצג("עבר את כולם?", ממוצע(סך, מספר_ציונים) > 60 וגם לא נכון)
