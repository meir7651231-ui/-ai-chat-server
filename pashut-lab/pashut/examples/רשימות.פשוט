# רשימות: ציונים של כיתה, ומספרים ראשוניים

ציונים = [90, 85, 77, 62, 100]
ציונים.הוסף(95)
הצג("הציונים:", ציונים)
הצג("כמה תלמידים:", כמה(ציונים))
הצג("ממוצע:", סכום(ציונים) / כמה(ציונים))
הצג("הכי גבוה:", הגדול(ציונים), " הכי נמוך:", הקטן(ציונים))
הצג("מסודרים:", מסודר(ציונים))
הצג("הראשון:", ציונים[0], " האחרון:", ציונים[-1])
אם 100 בתוך ציונים:
    הצג("מישהו קיבל 100!")

עברו = []
לכל ציון בתוך ציונים:
    אם ציון >= 80:
        עברו.הוסף(ציון)
הצג("עברו את 80:", עברו)

# הנפה של ארטוסתנס: כל הראשוניים עד 5 מיליון
גבול = 5000000
ראשוני = []
לכל i בתוך ספירה(גבול + 1):
    ראשוני.הוסף(נכון)
ראשוני[0] = לא נכון
ראשוני[1] = לא נכון
i = 2
כל עוד i * i <= גבול:
    אם ראשוני[i]:
        לכל j בתוך ספירה(i * i, גבול + 1, i):
            ראשוני[j] = לא נכון
    i += 1
ספירת_ראשוניים = 0
לכל ר בתוך ראשוני:
    אם ר:
        ספירת_ראשוניים += 1
הצג("ראשוניים עד", גבול, ":", ספירת_ראשוניים)
