# מילונים: ציונים לפי שם, וספירת מילים

ציונים = {"דנה": 90, "משה": 85, "רותם": 77}
ציונים["אבי"] = 95
ציונים["משה"] += 5
הצג("כל הציונים:", ציונים)
הצג("הציון של דנה:", ציונים["דנה"])
הצג("יש ציון לנועה?", "נועה" בתוך ציונים, "— אם אין, 0:", ציונים.קבל("נועה", 0))
לכל שם בתוך מסודר(ציונים):
    הצג(" ", שם, ציונים[שם])
הצג("ממוצע:", סכום(ערכים(ציונים)) / כמה(ציונים))

טקסט_ארוך = "השמש זורחת השמש שוקעת והים לא מלא השמש"
ספירה_מילים = {}
מילה = ""
לכל אות בתוך טקסט_ארוך + " ":
    אם אות == " ":
        אם מילה != "":
            ספירה_מילים[מילה] = ספירה_מילים.קבל(מילה, 0) + 1
        מילה = ""
    אחרת:
        מילה = מילה + אות
הצג("ספירת מילים:", ספירה_מילים)
הצג("שלוש האותיות הראשונות:", טקסט_ארוך[:3], " הפוך:", טקסט_ארוך[::-1][:8])

# מהירות: מיליון מפתחות
ד = {}
x = 1
לכל i בתוך ספירה(1000000):
    x = (x * 48271) % 2147483647
    ד[x % 500000] = ד.קבל(x % 500000, 0) + 1
הגדול_ביותר = 0
לכל k בתוך ד:
    אם ד[k] > הגדול_ביותר:
        הגדול_ביותר = ד[k]
הצג("מפתחות שונים:", כמה(ד), " הכי הרבה פעמים:", הגדול_ביותר)
