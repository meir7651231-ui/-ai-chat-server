# פותר סודוקו — דף אינטרנט.   בונים:  python3 pashut.py examples/סודוקו.פשוט --אתר
# השיטה: בכל פעם בוחרים את המשבצת הריקה שיש לה הכי מעט אפשרויות, מנסים כל אחת,
# ואם נתקעים — חוזרים צעד אחורה ומנסים את הבאה ("חיפוש לאחור").

כותרת("פותר סודוקו")
טקסט_בדף("כתוב ספרות במשבצות, או לחץ \"דוגמה\". אחר כך \"פתור\". משבצת ריקה היא משבצת שלא יודעים.")
לוח_משחק = לוח(9, 9)
כפתור("פתור", פתור)
כפתור("דוגמה", דוגמה)
כפתור("נקה", נקה_הכל)
הודעה = טקסט_בדף("")

מונה = [0]          # כמה ניסיונות עשינו (רשימה, כדי שפעולות יוכלו לשנות אותו)

# הסודוקו "הכי קשה בעולם" (ארטו אינקלה, 2012). 0 = משבצת ריקה
קשה = "800000000003600000070090200050007000000045700000100030001000068008500010090000400"

פעולה אפשרויות(ל: רשימה של מספר, מקום):
    ש = מקום // 9
    ע = מקום % 9
    תפוס = [לא נכון] * 10
    לכל i בתוך ספירה(9):
        תפוס[ל[ש * 9 + i]] = נכון
        תפוס[ל[i * 9 + ע]] = נכון
    פינה_ש = (ש // 3) * 3
    פינה_ע = (ע // 3) * 3
    לכל i בתוך ספירה(3):
        לכל j בתוך ספירה(3):
            תפוס[ל[(פינה_ש + i) * 9 + פינה_ע + j]] = נכון
    תוצאה = []
    לכל ספרה בתוך ספירה(1, 10):
        אם לא תפוס[ספרה]:
            תוצאה.הוסף(ספרה)
    תן תוצאה

פעולה פתור_מכאן(ל: רשימה של מספר):
    מונה[0] += 1
    הכי_טוב = -1
    אפשרויות_שלו = []
    לכל מקום בתוך ספירה(81):
        אם ל[מקום] == 0:
            א = אפשרויות(ל, מקום)
            אם כמה(א) == 0:
                תן לא נכון                       # משבצת בלי אף אפשרות: טעינו קודם
            אם הכי_טוב == -1 או כמה(א) < כמה(אפשרויות_שלו):
                הכי_טוב = מקום
                אפשרויות_שלו = א
    אם הכי_טוב == -1:
        תן נכון                                  # אין משבצות ריקות — פתרנו
    לכל ספרה בתוך אפשרויות_שלו:
        ל[הכי_טוב] = ספרה
        אם פתור_מכאן(ל):
            תן נכון
    ל[הכי_טוב] = 0                               # אף ספרה לא הצליחה — חוזרים אחורה
    תן לא נכון

פעולה קרא_לוח():
    ל = []
    לכל ש בתוך ספירה(9):
        לכל ע בתוך ספירה(9):
            ט = לוח_משחק.קרא(ש, ע)
            אם ט == "":
                ל.הוסף(0)
            אחרת:
                נסה:
                    ס = מספר(ט)
                אם נכשל:
                    ס = -1
                אם ס < 1 או ס > 9:
                    הודעה.שנה("במשבצת בשורה " + טקסט(ש + 1) + ", עמודה " + טקסט(ע + 1) + " כתוב \"" + ט + "\" — מותר רק 1 עד 9")
                    תן כלום
                ל.הוסף(ס)
    # בודקים שהספרות שנכתבו לא סותרות זו את זו
    לכל מקום בתוך ספירה(81):
        אם ל[מקום] != 0:
            ספרה = ל[מקום]
            ל[מקום] = 0
            אם ספרה לא בתוך אפשרויות(ל, מקום):
                הודעה.שנה("הספרה " + טקסט(ספרה) + " בשורה " + טקסט(מקום // 9 + 1) + ", עמודה " + טקסט(מקום % 9 + 1) + " מופיעה פעמיים")
                תן כלום
            ל[מקום] = ספרה
    תן ל

פעולה פתור():
    ל = קרא_לוח()
    אם ל == כלום:
        תן
    ריקות = []
    לכל מקום בתוך ספירה(81):
        אם ל[מקום] == 0:
            ריקות.הוסף(מקום)
    מונה[0] = 0
    אם פתור_מכאן(ל):
        לכל מקום בתוך ריקות:
            לוח_משחק.קבע(מקום // 9, מקום % 9, טקסט(ל[מקום]))
            לוח_משחק.סמן(מקום // 9, מקום % 9, נכון)
        הודעה.שנה("נפתר! מילאתי " + טקסט(כמה(ריקות)) + " משבצות, אחרי " + טקסט(מונה[0]) + " ניסיונות.")
    אחרת:
        הודעה.שנה("לסודוקו הזה אין פתרון.")

פעולה דוגמה():
    לוח_משחק.נקה()
    לכל מקום בתוך ספירה(81):
        אם קשה[מקום] != "0":
            לוח_משחק.קבע(מקום // 9, מקום % 9, קשה[מקום])
    הודעה.שנה("זה נחשב הסודוקו הקשה ביותר בעולם. לחץ \"פתור\".")

פעולה נקה_הכל():
    לוח_משחק.נקה()
    הודעה.שנה("")

דוגמה()
