# סופר מילים בקובץ טקסט.   הרצה:  ./מילים שם_קובץ.txt
ארג = ארגומנטים()
אם כמה(ארג) == 0:
    הצג("כתוב שם של קובץ, למשל: ./מילים שיר.txt")
אחרת:
    שם_קובץ = ארג[0]
    אם לא קיים_קובץ(שם_קובץ):
        הצג("אין קובץ בשם", שם_קובץ)
    אחרת:
        תוכן = קרא_קובץ(שם_קובץ)
        ספירה = {}
        לכל מילה בתוך תוכן.קטנות().פצל():
            מילה = מילה.נקה(".,!?:;\"'()")
            אם מילה != "":
                ספירה[מילה] = ספירה.קבל(מילה, 0) + 1
        הצג("שורות:", כמה(תוכן.שורות()), " מילים:", סכום(ערכים(ספירה)), " שונות:", כמה(ספירה))
        לכל מילה בתוך מסודר(ספירה):
            הצג(" ", מילה, "×", ספירה[מילה])
        כתוב_קובץ(שם_קובץ + ".ספירה", "\n".חבר(מסודר(מפתחות(ספירה))) + "\n")
        הצג("רשימת המילים נשמרה ב-" + שם_קובץ + ".ספירה")
