<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_main" android:layoutDirection="rtl">

    <!-- hero: the same living orb as the bubble, name, connection pill -->
    <LinearLayout android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="18dp" android:paddingBottom="6dp">
        <il.liba.app.OrbView android:id="@+id/orb" android:layout_width="108dp" android:layout_height="108dp" android:contentDescription="ליבה"/>
        <TextView android:id="@+id/brand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ליבה" android:textColor="#F3F5FF" android:textSize="30sp" android:fontFamily="sans-serif-light" android:letterSpacing="0.04" android:layout_marginTop="2dp" android:contentDescription="ליבה"/>
        <TextView android:id="@+id/dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● מנותק" android:textColor="#9AA3B8" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:background="@drawable/status_pill" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginTop="6dp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/steps" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="6dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/s1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="① התחבר" android:textColor="#7DF9FF" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:gravity="center" android:background="@drawable/chip_step_on" android:padding="10dp"/>
        <TextView android:id="@+id/s2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="② אשר" android:textColor="#9AA3B8" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:gravity="center" android:background="@drawable/chip_step" android:padding="10dp" android:layout_marginStart="8dp"/>
        <TextView android:id="@+id/s3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="③ דבר" android:textColor="#9AA3B8" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:gravity="center" android:background="@drawable/chip_step" android:padding="10dp" android:layout_marginStart="8dp"/>
    </LinearLayout>

    <FrameLayout android:id="@+id/webWrap" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginBottom="10dp" android:background="@drawable/card_glass" android:clipToOutline="true" android:padding="1dp">
        <WebView android:id="@+id/web" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="התחברות ל-claude.ai"/>
    </FrameLayout>

    <ScrollView android:id="@+id/logWrap" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" android:paddingStart="14dp" android:paddingEnd="14dp" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="משימות" android:textColor="#9AA3B8" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.08" android:paddingStart="8dp" android:paddingTop="4dp" android:paddingBottom="6dp"/>
            <TextView android:id="@+id/tasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F3F5FF" android:textSize="15sp" android:lineSpacingExtra="5dp" android:background="@drawable/card_glass" android:padding="16dp" android:text="אין משימות פתוחות" android:contentDescription="משימות"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="יומן" android:textColor="#9AA3B8" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.08" android:paddingStart="8dp" android:paddingTop="16dp" android:paddingBottom="6dp"/>
            <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F3F5FF" android:textSize="16sp" android:lineSpacingExtra="6dp" android:textDirection="rtl" android:background="@drawable/card_glass" android:padding="16dp" android:contentDescription="יומן השיחה"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="16dp" android:background="@drawable/card_glass_deep" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="8dp" android:elevation="8dp">
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#9AA3B8" android:textSize="13sp" android:gravity="center" android:contentDescription="מצב"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp" android:gravity="center">
            <Switch android:id="@+id/hey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="״ליבה״ מילת הפעלה  " android:textColor="#F3F5FF" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:layout_marginEnd="18dp" android:thumbTint="#7DF9FF" android:trackTint="#3A7DF9FF" android:contentDescription="מילת הפעלה"/>
            <Switch android:id="@+id/conv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="מצב שיחה  " android:textColor="#F3F5FF" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:thumbTint="#7DF9FF" android:trackTint="#3A7DF9FF" android:contentDescription="מצב שיחה"/>
        </LinearLayout>
        <Button android:id="@+id/toggle" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="הפעל בועה" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:textAllCaps="false" android:background="@drawable/pill_primary" android:textColor="#04050A" android:stateListAnimator="@null" android:contentDescription="הפעל בועה"/>
        <Button android:id="@+id/reveal" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="הצג את הדף החי" android:textSize="15sp" android:textAllCaps="false" android:background="@drawable/pill_ghost" android:textColor="#F3F5FF" android:stateListAnimator="@null" android:visibility="gone"/>
        <Button android:id="@+id/update" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="יש גרסה חדשה – התקן" android:textSize="15sp" android:textAllCaps="false" android:fontFamily="sans-serif-medium" android:background="@drawable/pill_amber" android:textColor="#04050A" android:stateListAnimator="@null" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
