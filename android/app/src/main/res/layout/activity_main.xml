<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#04050A">
    <WebView android:id="@+id/web" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <ScrollView android:id="@+id/logWrap" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" android:padding="16dp">
        <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#EEF1FF" android:textSize="16sp" android:lineSpacingExtra="6dp" android:textDirection="rtl"/>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:background="#0A0C16">
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#9AA3B8" android:textSize="14sp" android:gravity="center"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:gravity="center">
            <Switch android:id="@+id/hey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="״ליבה״ – מילת הפעלה  " android:textColor="#EEF1FF" android:textSize="15sp" android:layout_marginEnd="18dp"/>
            <Switch android:id="@+id/conv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="מצב שיחה  " android:textColor="#EEF1FF" android:textSize="15sp"/>
        </LinearLayout>
        <Button android:id="@+id/toggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="הפעל בועה" android:textSize="18sp" android:backgroundTint="#7DF9FF" android:textColor="#04050A"/>
        <Button android:id="@+id/reveal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="הצג את הדף החי (דקה וחצי)" android:textSize="15sp" android:backgroundTint="#2C3140" android:textColor="#EEF1FF" android:visibility="gone"/>
        <Button android:id="@+id/update" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="יש גרסה חדשה – הורד" android:textSize="15sp" android:backgroundTint="#FFB454" android:textColor="#04050A" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
