{
  "_": "צרכים = דאטה, לא קוד. כל צורך: מאיזו צורה הוא נגזר, איך הנבחר נקרא (recipe), ודוגמאות מחייבות שכל מועמד חייב לעבור בריצה. דוגמה יחידה מסוכנת (pop-call עבר «ייחוד» על דוגמה אחת) — לכן ≥3 דוגמאות עם קצוות.",
  "needs": [
    { "id": "sum", "from": { "dashboard": "סכום" }, "label": "סכום שדה-מספר על כל השורות", "recipe": ["rows", "get"],
      "examples": [
        { "args": [[{"a":1},{"a":2}], {"$fn":"x=>x.a"}], "want": 3 },
        { "args": [[], {"$fn":"x=>x.a"}], "want": 0 },
        { "args": [[{"a":5}], {"$fn":"x=>x.a"}], "want": 5 },
        { "args": [[{"a":1.5},{"a":2.5},{"a":0}], {"$fn":"x=>x.a"}], "want": 4 }
      ] },
    { "id": "count-by", "from": { "dashboard": "מונה", "shape": "enum" }, "label": "ספירה לפי ערך, מהגדול לקטן", "recipe": ["rows", "get"],
      "examples": [
        { "args": [[{"s":"a"},{"s":"b"},{"s":"a"}], {"$fn":"x=>x.s"}], "want": [["a",2],["b",1]] },
        { "args": [[{"s":"b"},{"s":"b"},{"s":"a"},{"s":"c"},{"s":"c"},{"s":"c"}], {"$fn":"x=>x.s"}], "want": [["c",3],["b",2],["a",1]] },
        { "args": [[], {"$fn":"x=>x.s"}], "want": [] }
      ] },
    { "id": "money", "from": { "shape": "number" }, "label": "מספר ⇒ תצוגת-שקלים עם מפרידי-אלפים", "recipe": ["value"],
      "examples": [
        { "args": [1234567], "want": "₪1,234,567" },
        { "args": [0], "want": "₪0" },
        { "args": [12], "want": "₪12" },
        { "args": [999.6], "want": "₪1,000" }
      ] },
    { "id": "fmt-date", "from": { "shape": "date" }, "label": "תאריך-ISO ⇒ יום/חודש/שנה", "recipe": ["value"],
      "examples": [
        { "args": ["2026-09-14"], "want": "14/09/2026" },
        { "args": ["2026-01-05"], "want": "05/01/2026" },
        { "args": [""], "want": "—" },
        { "args": [null], "want": "—" }
      ] },
    { "id": "days-since", "from": { "shape": "date" }, "label": "ימים שעברו מתאריך עד היום (שלילי = עתיד)", "recipe": ["value", "today"],
      "examples": [
        { "args": ["2026-09-01", "2026-09-14"], "want": 13 },
        { "args": ["2026-09-14", "2026-09-14"], "want": 0 },
        { "args": ["2026-09-15", "2026-09-14"], "want": -1 },
        { "args": ["2025-09-14", "2026-09-14"], "want": 365 },
        { "args": ["2024-02-28", "2024-03-01"], "want": 2 }
      ] },
    { "id": "phone-format", "from": { "shape": "phone" }, "label": "טלפון ⇒ תצוגה ישראלית עם מקף", "recipe": ["value"],
      "examples": [
        { "args": ["0501234567"], "want": "050-1234567" },
        { "args": ["+972501234567"], "want": "050-1234567" },
        { "args": ["031234567"], "want": "03-1234567" },
        { "args": ["050-1234567"], "want": "050-1234567" },
        { "args": ["אבג"], "want": "אבג" }
      ] },
    { "id": "phone-norm", "from": { "shape": "phone" }, "label": "טלפון ⇒ ספרות בלבד (לזיהוי כפילויות)", "recipe": ["value"],
      "examples": [
        { "args": ["050-123-4567"], "want": "0501234567" },
        { "args": ["+972 50 123 4567"], "want": "0501234567" },
        { "args": ["03 1234567"], "want": "031234567" },
        { "args": [""], "want": "" }
      ] },
    { "id": "norm-search", "from": { "shape": "text" }, "label": "נרמול טקסט לחיפוש (ניקוד, סופיות, גרשיים)", "recipe": ["value"],
      "examples": [
        { "args": ["שָׁלוֹם"], "want": "שלומ" },
        { "args": ["ABC"], "want": "abc" },
        { "args": [null], "want": "" },
        { "args": [" יוסף "], "want": "יוספ" },
        { "args": ["כהן ז\"ל"], "want": "כהנ זל" }
      ] }
  ]
}
