{
  "version": 1,
  "note": "The one definition of what the page and the bubble say to each other. Edit here, then run node tools/gen-protocol.mjs. Generated files say so at the top and are checked by gates/protocol.mjs.",
  "caps": [
    "beat",
    "clock",
    "proto",
    "pulse",
    "spoke",
    "state",
    "trace",
    "mem",
    "remind"
  ],
  "toApp": {
    "ready": {
      "fields": {},
      "relay": "ready=true;"
    },
    "say": {
      "fields": {
        "text": "str",
        "kind": "str=say",
        "options": "list",
        "speaker": "str",
        "id": "str",
        "mid": "str"
      }
    },
    "sent": {
      "fields": {
        "text": "str"
      }
    },
    "error": {
      "fields": {
        "text": "str",
        "reason": "str"
      }
    },
    "queued": {
      "fields": {
        "text": "str"
      },
      "why": "a sentence said while ליבה is speaking waits; the bubble shows it waits"
    },
    "outbox": {
      "fields": {
        "text": "str",
        "n": "int",
        "reason": "str"
      },
      "why": "no network: the sentence is kept and will be sent; the bubble shows how many wait"
    },
    "tap": {
      "fields": {}
    },
    "cmd": {
      "fields": {
        "cmd": "str"
      }
    },
    "crashSaved": {
      "fields": {
        "id": "str"
      }
    },
    "tasks": {
      "fields": {
        "summary": "str",
        "n": "int",
        "blocked": "int"
      }
    },
    "traceAck": {
      "fields": {
        "batch": "str",
        "ids": "list"
      }
    },
    "state": {
      "fields": {
        "state": "str"
      },
      "why": "the page tells the bubble what it is doing, so the two never disagree about who is speaking"
    },
    "memSync": {
      "fields": {
        "body": "str"
      },
      "why": "device-mem: the page sends the phone its memory - the 500 facts used most, the person cards, the rules - so the bubble can answer when the page is down"
    },
    "memAck": {
      "fields": {
        "ids": "list"
      },
      "why": "device-mem: the page stored what the phone kept offline; the phone lets those go"
    },
    "remind": {
      "fields": {
        "items": "str"
      },
      "why": "proactive: the date reminders, so the phone's alarm says them even when the page is dead or the phone just restarted"
    }
  },
  "toPage": {
    "hello": {
      "fields": {
        "ver": "str",
        "proto": "str",
        "pv": "int",
        "caps": "list",
        "wall": "int",
        "state": "str",
        "urgent": "str",
        "spoken": "str"
      },
      "from": {
        "ver": "window.__libaVer||''",
        "proto": "HASH",
        "pv": "VERSION",
        "caps": "CAPS",
        "wall": "Date.now()",
        "state": "window.__libaState||''",
        "urgent": "window.__libaUrgent||''",
        "spoken": "window.__libaSpoken||''"
      }
    },
    "crash": {
      "fields": {
        "id": "str",
        "version": "str",
        "text": "str"
      }
    },
    "spoke": {
      "fields": {
        "id": "str",
        "startAt": "int",
        "endAt": "int",
        "cause": "str=done"
      }
    },
    "speaking": {
      "fields": {
        "id": "str"
      }
    },
    "input": {
      "fields": {
        "text": "str",
        "source": "str=voice",
        "stamps": "str"
      }
    },
    "trace": {
      "fields": {
        "batch": "str",
        "events": "str"
      }
    },
    "pulse": {
      "fields": {
        "dev": "str",
        "name": "str",
        "body": "str"
      },
      "why": "one sign of life per device, edge-triggered (a change, or every five minutes); the page keeps it in one fixed document pulse/<dev>"
    },
    "memAsk": {
      "fields": {
        "items": "str"
      },
      "why": "device-mem: what Meir asked the phone to remember while the page was down, sent when it is back"
    }
  },
  "compat": "Adding an optional field is compatible and keeps the version; removing or renaming a message or a field bumps it.",
  "states": {
    "note": "One state table for the page and the bubble. A move not listed here is recorded as a fault (P_STATE_ILLEGAL / E_STATE_ILLEGAL) and still applied - the table is tightened from what the field reports, never by breaking the phone.",
    "initial": "OFFLINE",
    "moves": {
      "OFFLINE": [
        "IDLE",
        "WAKE"
      ],
      "IDLE": [
        "LISTENING",
        "THINKING",
        "SPEAKING",
        "SENDING",
        "RINGING",
        "QUIET",
        "DEGRADED",
        "WAKE",
        "OFFLINE"
      ],
      "WAKE": [
        "LISTENING",
        "IDLE",
        "SPEAKING",
        "SENDING",
        "RINGING",
        "OFFLINE"
      ],
      "LISTENING": [
        "THINKING",
        "SENDING",
        "IDLE",
        "SPEAKING",
        "WAKE",
        "OFFLINE"
      ],
      "THINKING": [
        "SENDING",
        "SPEAKING",
        "IDLE",
        "OFFLINE"
      ],
      "SENDING": [
        "IDLE",
        "SPEAKING",
        "RINGING",
        "THINKING",
        "DEGRADED",
        "WAKE",
        "LISTENING",
        "OFFLINE"
      ],
      "SPEAKING": [
        "IDLE",
        "LISTENING",
        "SENDING",
        "WAKE",
        "RINGING",
        "OFFLINE"
      ],
      "RINGING": [
        "SPEAKING",
        "IDLE",
        "LISTENING",
        "OFFLINE"
      ],
      "QUIET": [
        "IDLE",
        "SPEAKING",
        "OFFLINE"
      ],
      "DEGRADED": [
        "IDLE",
        "SPEAKING",
        "SENDING",
        "OFFLINE"
      ]
    }
  }
}
