+      const own = o.detail.find((t) => new RegExp('\\{' + G.pValueWord + '\\}').test(t));
+      const enumLabels = [...fields.filter((f) => f.enumVals).map((f) => f.label), ...decisions.map((dd) => dd.label), ...(classes.length ? [P.classifyField] : [])];
