@@ -53,6 +53,13 @@ const allText = (sec) => [...sec.lines, ...sec.subs.flatMap((s) => s.lines)];
 function fieldsFrom(lines) {
   const out = []; let req = false;
   const push = (txt, required) => {
+    // «עדיפות: גבוהה / בינונית / נמוכה» ⇒ בחירה-סגורה בשם-השדה (≥2 ערכים קצרים אחרי נקודתיים, מופרדים ב-/) — מבני, אפס-מילון
+    const ch = txt.match(/^([^:：]+?)\s*[:：]\s*(.+)$/);
+    if (ch) {
+      const label = heW(ch[1]).slice(0, P.fieldMaxWords).join(' ');
+      const vals = ch[2].split('/').map((x) => clean(x)).filter(Boolean);
+      if (label.length > 1 && vals.length >= 2 && vals.every((v) => heW(v).length <= P.fieldMaxWords) && !out.some((f) => f.label === label)) { out.push({ label, enumVals: vals, required }); return; }
+    }
     const base = txt.split('/')[0].replace(/\(.*?\)/g, '').trim();
     const or = base.split(new RegExp('\\s+' + P.orWord + '\\s+'));
     if (or.length === 2 && or.every((x) => heW(x).length && heW(x).length <= 2)) { out.push({ label: clean(or[0]) + ' ' + P.orWord + ' ' + clean(or[1]), enumVals: [clean(or[0]), clean(or[1])], required }); return; }
