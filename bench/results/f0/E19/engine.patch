diff --git a/machtzev/generator/peruk.mjs b/machtzev/generator/peruk.mjs
index 0c5043c..9a7eeae 100644
--- a/machtzev/generator/peruk.mjs
+++ b/machtzev/generator/peruk.mjs
@@ -165,7 +165,10 @@ export function perukToSpec(md, ns) {
   for (const [tgt, q] of P.questions || []) lines.push(`${G.questionWord} ${tgt}: ${q}`);   // G28 · מסך = שאלה אחת
   lines.push(`${G.entityNouns[0]} ${root} ${G.withWord} ${rootFields.join(', ')} | ${G.stagePrefixes[0]} ${P.stages.join(', ')}`);
   if (severity) lines.push(`${G.entityNouns[0]} ${fnd} ${G.withWord} ${P.findingFields.map((f, i) => i === 0 ? f.replace(/\*$/, '') + '*' : f).join(', ')}, ${P.severityField}{${P.severity.join('|')}} | ${G.markDelete[0]}: ${root}=${Object.keys(G.delPolicies)[0]}`);
-  lines.push(`${P.dashWord} ${G.withWord} ${P.dashboardCount}(${root})${severity ? `, ${P.sevCount || P.dashboardCount}(${fnd}: ${P.severityField}=${P.severity[0]})` : ''}`);
+  // מונה-מסונן על הסיווג (לוח-בקרה): סיווג שההסתייגות-הכתובה-של-הבעלים נוקבת בשמו («דגל מוגן / סילוק — עו״ד») = המקרה
+  // שהמוצר רק מסמן ומוסר הלאה ⇒ הלוח סופר אותו, כמו 'אדום' בממצאים. מבני: שם-הסיווג ⊂ נוסח-ההסתייגות; אפס מילון-דומייני.
+  const handoff = disclaimer && !disclaimerDefault ? classes.filter((c) => norm(disclaimer).includes(c)) : [];
+  lines.push(`${P.dashWord} ${G.withWord} ${P.dashboardCount}(${root})${severity ? `, ${P.sevCount || P.dashboardCount}(${fnd}: ${P.severityField}=${P.severity[0]})` : ''}${handoff.map((c) => `, ${P.dashboardCount}(${root}: ${P.classifyField}=${c})`).join('')}`);
   lines.push(`${P.roleWord} ${P.roleAll}`);
   lines.push(`${G.particleWord} ${root}: [${G.pTable[0]}]`);
   lines.push(`${G.particleWord} ${root}: [${G.pAct[0]}] ${P.openAction}`);
