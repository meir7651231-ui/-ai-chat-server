diff --git a/machtzev/generator/particles.mjs b/machtzev/generator/particles.mjs
index 8f44fe1..fbab763 100644
--- a/machtzev/generator/particles.mjs
+++ b/machtzev/generator/particles.mjs
@@ -405,7 +405,16 @@ export function particleWidgets({ entity, plan, k, recs: recsOverride = null })
       const cols = s.columns ? entity.schema.filter((f) => s.columns.includes(f.label)) : entity.schema;
       const labels = cols.map((f) => k(f.label));
       // מיון מהספק: מספרי כשניתן, אחרת לקסיקלי; ריק ⇒ אחרון; מפתחות משורשרים; יורד ⇒ היפוך
-      const cmp = (s.sort || []).map((o) => { const kc = k(o.field); return `{ final x = a[${kc}] ?? '', y = b[${kc}] ?? ''; if (x.isEmpty != y.isEmpty) return x.isEmpty ? 1 : -1; final nx = num.tryParse(x), ny = num.tryParse(y); final c = (nx != null && ny != null) ? nx.compareTo(ny) : x.compareTo(y); if (c != 0) return ${o.desc ? '-c' : 'c'}; }`; }).join(' ');
+      const cmp = (s.sort || []).map((o) => {
+        const kc = k(o.field);
+        const fld = entity.schema.find((f) => f.label === o.field);
+        const enumVals = fld && fld.enumVals ? fld.enumVals : null;
+        if (enumVals) {
+          const enumMap = enumVals.reduce((acc, val, idx) => ({ ...acc, [k(val)]: idx }), {});
+          return `{ final x = a[${kc}] ?? '', y = b[${kc}] ?? ''; if (x.isEmpty != y.isEmpty) return x.isEmpty ? 1 : -1; final xi = ${JSON.stringify(enumMap)}[x] ?? 999, yi = ${JSON.stringify(enumMap)}[y] ?? 999; final c = xi.compareTo(yi); if (c != 0) return ${o.desc ? '-c' : 'c'}; }`;
+        }
+        return `{ final x = a[${kc}] ?? '', y = b[${kc}] ?? ''; if (x.isEmpty != y.isEmpty) return x.isEmpty ? 1 : -1; final nx = num.tryParse(x), ny = num.tryParse(y); final c = (nx != null && ny != null) ? nx.compareTo(ny) : x.compareTo(y); if (c != 0) return ${o.desc ? '-c' : 'c'}; }`;
+      }).join(' ');
       const src = s.sort ? `(${recs}.toList()..sort((a, b) { ${cmp} return 0; }))` : recs;
       const rows = `[for (final r in ${src}) [${cols.map((f) => strOf(f.label)).join(', ')}]]`;
       const w = firstWired(kd[0][1], { labels, rows, label: lbl }); if (!w) { notes.push(`⚪ ${p.name}: אין אטום-טבלה מתחווט`); continue; }
