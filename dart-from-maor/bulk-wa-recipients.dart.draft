dynamic bulkWaRecipients(dynamic sups, dynamic waDigits) {
  var seen = <dynamic>{};
  var out = [];
  for (final sp in sups) {
  var digits = waDigits((sp.phone ?? ''));
  if (_falsy(digits)) continue;
  if (seen.has(digits)) continue;
  seen.add(digits);
  out.add({'id': sp.id, 'name': (sp.name ?? ''), 'phone': sp.phone, 'digits': digits});
}
  return out;
}