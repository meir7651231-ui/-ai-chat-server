dynamic parseVcards(dynamic text, dynamic unfoldLines, dynamic splitProperty, dynamic decodeValue, dynamic phoneLabel, dynamic joinAddress) {
  var lines = unfoldLines((text ?? ''));
  var out = [];
  var cur = null;
  for (final line in lines) {
  var trimmed = line.trim();
  if (_falsy(trimmed)) continue;
  if (RegExp(r'^BEGIN:VCARD$').test(trimmed)) {
  cur = {'fullName': '', 'family': '', 'given': '', 'phones': [], 'emails': [], 'org': '', 'title': '', 'address': '', 'note': ''};
  continue;
}
  if (RegExp(r'^END:VCARD$').test(trimmed)) {
  if (cur) {
  if (_falsy(cur.fullName)) {
  cur.fullName = [cur.given, cur.family].where(Boolean).join(' ').trim();
}
  out.add(cur);
}
  cur = null;
  continue;
}
  if (_falsy(cur)) continue;
  var prop = splitProperty(line);
  if (_falsy(prop)) continue;
  var undefined = prop;
  switch (name) {
case 'FN':
cur.fullName = decodeValue(value, params).trim();
break;
case 'N':
{
  var decoded = decodeValue(value, params);
  var segs = decoded.split(';');
  cur.family = ((segs[0] ?? '')).trim();
  cur.given = ((segs[1] ?? '')).trim();
  break;
}
case 'TEL':
{
  var v = value.trim();
  if (v) cur.phones.add({'value': v, 'label': phoneLabel(params)});
  break;
}
case 'EMAIL':
{
  var v = decodeValue(value, params).trim();
  if (v) cur.emails.add(v);
  break;
}
case 'ORG':
{
  var v = decodeValue(value, params).replaceFirst(RegExp(r';+$'), '').trim();
  if (v && v.toLowerCase() != 'null') cur.org = v;
  break;
}
case 'TITLE':
cur.title = decodeValue(value, params).trim();
break;
case 'ADR':
cur.address = joinAddress(value, params);
break;
case 'NOTE':
cur.note = decodeValue(value, params).trim();
break;
default:
break;
}
}
  return out;
}