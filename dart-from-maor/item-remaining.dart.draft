dynamic itemRemaining(dynamic db, dynamic itemId, dynamic liveRedemptions) {
  var item = db.shopItems.firstWhere((i) => i.id == itemId);
  if ((_falsy(item) || item.stock == undefined)) return null;
  var used = 0;
  for (final a in db.shopAssignments) {
  var p = db.shopProducts.firstWhere((x) => x.id == a.productId);
  if (_falsy(p)) continue;
  for (final r in liveRedemptions(a)) {
  var c = p.components.firstWhere((x) => x.id == r.componentId);
  if (c.itemId == itemId) used++;
}
}
  return max(0, item.stock - used);
}
