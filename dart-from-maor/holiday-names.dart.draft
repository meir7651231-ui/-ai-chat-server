dynamic holidayNames(dynamic holidayOf) {
  var out = [];
  var seen = <dynamic>{};
  var start = DateTime.parse('2026-01-01T12:00:00');
  for (var i = 0; i < 400; i++) {
  var d = DateTime.parse(start.year, (start.month - 1), start.day + i);
  var name = holidayOf(d);
  if (name && !seen.has(name)) {
  seen.add(name);
  out.add(name);
}
}
  return out;
}
