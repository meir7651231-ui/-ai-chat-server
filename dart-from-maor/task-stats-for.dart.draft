dynamic taskStatsFor(dynamic tasks, dynamic identity, dynamic todayIso, dynamic taskIdentity, dynamic taskOverdue) {
  var me = taskIdentity(identity);
  var mine = tasks.where((t) => taskIdentity(t.assignee) == me);
  var t0 = DateTime.parse(todayIso + 'T12:00:00').millisecondsSinceEpoch;
  var open = 0;
  for (final t in mine) {
  if (_falsy(t.doneAt)) {
  open++;
  if (taskOverdue(t, todayIso)) overdue++;
} else {
  done++;
  var d = DateTime.parse(((t.doneAt ?? '')).sublist(0, 10) + 'T12:00:00').millisecondsSinceEpoch;
  var diff = (t0 - d) / 86400000;
  if (diff >= 0 && diff < 7) doneWeek++;
}
}
  return {'open': open, 'overdue': overdue, 'done': done, 'doneWeek': doneWeek};
}
