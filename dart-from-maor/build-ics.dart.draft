dynamic basicDate(dynamic iso) {
  return iso.replaceFirst(RegExp(r'-'), '');
}
dynamic basicLocal(dynamic d) {
  dynamic p(dynamic n, [dynamic w = 2]) => n.toString()._padStart(w, '0');
  return (d.year.toString() + p((d.month - 1) + 1) + p(d.day) + 'T' + p(d.hour) + p(d.minute) + p(d.getSeconds()));
}
dynamic stampUtc(dynamic now) {
  dynamic p(dynamic n) => n.toString()._padStart(2, '0');
  return (now.getUTCFullYear().toString() + p(now.getUTCMonth() + 1) + p(now.getUTCDate()) + 'T' + p(now.getUTCHours()) + p(now.getUTCMinutes()) + p(now.getUTCSeconds()) + 'Z');
}
dynamic nextIso(dynamic iso) {
  var d = DateTime.parse(iso + 'T12:00:00');
  d.setDate(d.day + 1);
  dynamic p(dynamic n) => n.toString()._padStart(2, '0');
  return d.year.toString() + '-' + p((d.month - 1) + 1) + '-' + p(d.day);
}
dynamic buildIcs(dynamic occurrences, dynamic calName, dynamic now, dynamic icsEscape, dynamic foldIcsLine) {
  var lines = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//maor-system//he//', 'CALSCALE:GREGORIAN', 'METHOD:PUBLISH', 'X-WR-CALNAME:' + icsEscape(calName)];
  var stamp = stampUtc(now);
  for (final oc in occurrences) {
  lines.add('BEGIN:VEVENT');
  lines.add('UID:' + icsEscape(oc.uid));
  lines.add('DTSTAMP:' + stamp);
  var parsedStart = oc.time && RegExp(r'^\d{2}:\d{2}$').test(oc.time) ? DateTime.parse(oc.date + 'T' + oc.time + ':00') : null;
  if (parsedStart && !Number.isNaN(parsedStart.millisecondsSinceEpoch)) {
  var end = DateTime.parse(parsedStart.millisecondsSinceEpoch + 3600000);
  lines.add('DTSTART:' + basicLocal(parsedStart));
  lines.add('DTEND:' + basicLocal(end));
} else {
  lines.add('DTSTART;VALUE=DATE:' + basicDate(oc.date));
  lines.add('DTEND;VALUE=DATE:' + basicDate(nextIso(oc.date)));
}
  lines.add('SUMMARY:' + icsEscape(oc.title));
  if (oc.notes) lines.add('DESCRIPTION:' + icsEscape(oc.notes));
  if (oc.location) lines.add('LOCATION:' + icsEscape(oc.location));
  lines.add('END:VEVENT');
}
  lines.add('END:VCALENDAR');
  return lines.expand(foldIcsLine).toList().join('
') + '
';
}
