dynamic payLink(dynamic payUrl, dynamic amount, [dynamic name = ''], dynamic safeHttpsUrl) {
  var base = safeHttpsUrl(payUrl);
  if (_falsy(base)) return null;
  var amt = max(0, _round(amount * 100) / 100).toString();
  if ((base.contains('%7Bamount%7D') ?? base.contains('{amount}'))) {
  return base.replaceFirst(RegExp(r'%7Bamount%7D|\{amount\}'), amt == '0' ? '' : encodeURIComponent(amt)).replaceFirst(RegExp(r'%7Bname%7D|\{name\}'), encodeURIComponent(name));
}
  var u = URL(base);
  if (RegExp(r'(^|\.)matara\.pro$').test(u.hostname) && RegExp(r'nedarimplus').test(u.pathname + u.search)) {
  if (amt != '0') u.searchParams.set('Amount', amt);
  if (name.trim()) u.searchParams.set('ClientName', name.trim());
  return ufunction toString() { [native code] };
}
  if (amt != '0') u.searchParams.set('amount', amt);
  if (name.trim()) u.searchParams.set('name', name.trim());
  return ufunction toString() { [native code] };
}