dynamic redemptionsCsvRows(dynamic db, dynamic config, dynamic beneficiaryLabel, dynamic itemOf) {
  var rows = [['תאריך', 'מוטב', 'פריט', 'חבילה', 'שולם', 'שווי', 'אישור', 'מבוטל']];
  for (final a in db.shopAssignments) {
  var product = db.shopProducts.firstWhere((p) => p.id == a.productId);
  var who = beneficiaryLabel(db, a, config);
  for (final r in a.redemptions) {
  var comp = product.components.firstWhere((c) => c.id == r.componentId);
  rows.add([r.date, who, comp ? itemOf(db, comp).name : '', (product.name ?? ''), r.paid, r.value, (r.rid ?? ''), r.voidedAt ? 'בוטל ב-' + r.voidedAt : '']);
}
}
  return rows;
}