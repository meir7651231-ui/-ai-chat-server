dynamic collectionsCsvRows(dynamic db, dynamic config, dynamic termOf) {
  dynamic T(dynamic k, dynamic fb) => (config ? termOf(config, k, fb) : fb);
  var rows = [['תאריך', 'רכז', 'קופה', T('entity.family', 'משפחה'), 'סכום', 'מבצע']];
  for (final b in db.tzBoxes) {
  var coord = db.tzCoordinators.firstWhere((c) => c.id == b.coordinatorId);
  var fam = db.families.firstWhere((f) => f.id == b.famId);
  for (final c in b.collections) {
  var camp = c.campaignId ? db.tzCampaigns.firstWhere((p) => p.id == c.campaignId) : undefined;
  rows.add([c.date, (coord.name ?? ''), '#' + b.num, (fam.name ?? ''), c.amount, (camp.name ?? '')]);
}
}
  return rows;
}
