dynamic scheduleClashText(dynamic db, dynamic memberId, dynamic course, dynamic sessionsOf, [dynamic dayNames = ['ראשון', 'שני', 'שלישי', 'רביעי', 'חמישי', 'שישי']]) {
  var target = sessionsOf(course);
  for (final e in db.enrollments) {
  if (((e.memberId != memberId || e.status == 'ended') || e.courseId == course.id)) continue;
  var other = db.courses.firstWhere((x) => x.id == e.courseId);
  if (_falsy(other)) continue;
  for (final s1 in target) {
  for (final s2 in sessionsOf(other)) {
  if (s1.day == s2.day && _falsy(_falsy(s1.time)) && s1.time == s2.time) {
  return '⚠ התנגשות לו"ז: כבר משובצ/ת ל"' + other.name + '" — יום ' + dayNames[s1.day] + ' ' + s1.time;
}
}
}
}
  return null;
}
