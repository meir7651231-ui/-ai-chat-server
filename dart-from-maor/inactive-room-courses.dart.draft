dynamic inactiveRoomCourses(dynamic db, dynamic iso, dynamic config, dynamic termOf) {
  var out = [];
  for (final c in db.courses) {
  if (c.end && iso > c.end) continue;
  if (_falsy(c.roomId)) continue;
  var room = db.rooms.firstWhere((r) => r.id == c.roomId);
  if (_falsy(room)) out.add({'course': c, 'roomName': termOf(config, 'entity.room', 'חדר') + ' לא קיים'}); else if (_falsy(room.active)) out.add({'course': c, 'roomName': room.name});
}
  return out;
}
