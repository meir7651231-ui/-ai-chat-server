dynamic segulaReminders(dynamic startIso, [dynamic offsets = [1, 7, 21, 35, 40]]) {
  var base = DateTime.parse('${startIso}T12:00:00');
  var max = max(...offsets);
  return offsets.map((day) {
  var d = DateTime.parse(base);
  d.setDate(d.day + day);
  var y = d.year;
  var m = (d.month - 1) + 1.toString()._padStart(2, '0');
  var dd = d.day.toString()._padStart(2, '0');
  return {'day': day, 'date': '${y}-${m}-${dd}', 'final': day == max};
}).toList();
}
