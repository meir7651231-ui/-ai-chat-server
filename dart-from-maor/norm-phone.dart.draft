dynamic normPhone(dynamic s) {
  var d = ((s ?? '')).replaceFirst(RegExp(r'\D'), '');
  if (RegExp(r'^(\d)\1+$').test(d)) return '';
  d = d.replaceFirst(RegExp(r'^00'), '');
  if (d.startsWith('972')) d = '0' + d.sublist(3);
  return d.replaceFirst(RegExp(r'^0{2,}'), '0');
}
dynamic nameCityKey(dynamic f) {
  var n = ((f.name ?? '')).trim().replaceFirst(RegExp(r'\s+'), ' ').toLowerCase();
  var c = ((f.city ?? '')).trim().toLowerCase();
  return n && c ? n + '|' + c : '';
}
dynamic phonesOf(dynamic f) {
  return [normPhone(f.phone), normPhone(f.phone2)].where((p) => p.length >= 7);
}