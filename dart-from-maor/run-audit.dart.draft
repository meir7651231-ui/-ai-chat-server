var EMAIL_RE = RegExp(r'^[^\s@]+@[^\s@]+\.[^\s@]{2,}$');
dynamic digits(dynamic x) => ((x ?? '')).replaceFirst(RegExp(r'\D'), '');
dynamic runAudit(dynamic db, [dynamic todayIso = ''], [dynamic extra = true], dynamic config, dynamic deps) {
  var undefined = deps;
  var issues = [];
  dynamic T(dynamic k, dynamic fb) => (config ? termOf(config, k, fb) : fb);
  dynamic add(dynamic cat, dynamic title, dynamic famId) => issues.add({'cat': cat, 'title': title, 'famId': famId});
  dynamic members(dynamic f) => ((f.members is List) ? f.members : []);
  var g1 = {};
  var g2 = {};
  var g3 = {};
  for (final f in ((db.families is List) ? db.families : [])) {
  var k1 = normName(f.name) + '|' + normName((f.mother ?? ''));
  (g1[k1] = (g1[k1] ?? [])).add(f);
  for (final p in [f.phone, f.phone2]) {
  var d = digits(p);
  if (d.length >= 7) (g2[d] = (g2[d] ?? [])).add(f);
}
  for (final idn in [f.fatherId, f.motherId]) {
  var d = digits(idn);
  if (d.length >= 5) (g3[d] = (g3[d] ?? [])).add(f);
}
}
  /*?ForInStatement?*/
  var seenPair = <dynamic>{};
  /*?ForInStatement?*/
  /*?ForInStatement?*/
  for (final f in ((db.families is List) ? db.families : [])) {
  for (final undefined in [[f.fatherId, 'אב'], [f.motherId, 'אם']]) {
  var d = digits(idn);
  if (d.length && !validIsraeliId(d)) add('ת"ז', T('entity.familyOf', 'משפחת') + ' ' + f.name + ': ת"ז ' + who + ' לא עוברת ספרת ביקורת (' + idn + ')', f.id);
}
  for (final p in [f.phone, f.phone2]) {
  var pi = phoneIssue(p);
  if (pi) add('טלפון', T('entity.familyOf', 'משפחת') + ' ' + f.name + ': ' + pi, f.id);
}
  if (f.email && !EMAIL_RE.test(f.email)) add('אימייל', T('entity.familyOf', 'משפחת') + ' ' + f.name + ': אימייל לא תקין (' + f.email + ')', f.id);
  if (f.status != 'inactive') {
  if (_falsy(f.city)) add('כתובת', T('entity.familyOf', 'משפחת') + ' ' + f.name + ': חסרה עיר', f.id); else if (_falsy(f.address)) add('כתובת', T('entity.familyOf', 'משפחת') + ' ' + f.name + ': יש עיר אבל חסרה כתובת', f.id);
}
  var single = ((f.maritalStatus == 'אלמן/ה' || f.maritalStatus == 'גרושים') || f.maritalStatus == 'פרודים');
  if (single && f.father && f.mother) add('לוגיקה', T('entity.familyOf', 'משפחת') + ' ' + f.name + ': מסומנת "' + f.maritalStatus + '" — אמורה להיות בלי בן/בת זוג, אבל רשומים שניים (' + f.father + ' + ' + f.mother + ')', f.id); else if (single && digits(f.fatherId) && digits(f.motherId)) add('לוגיקה', T('entity.familyOf', 'משפחת') + ' ' + f.name + ': מסומנת "' + f.maritalStatus + '" אבל רשומות שתי תעודות זהות של בני זוג', f.id);
  if (f.maritalStatus == 'נשואים' && f.status == 'active' && _falsy(f.father) && _falsy(f.mother)) add('לוגיקה', T('entity.familyOf', 'משפחת') + ' ' + f.name + ': מסומנת נשואים אבל לא רשום אף בן זוג', f.id);
  if (!digits(f.phone) && !digits(f.phone2) && _falsy(f.email)) add('קשר', T('entity.familyOf', 'משפחת') + ' ' + f.name + ': אין שום פרט קשר (טלפון או אימייל)', f.id);
  var seenKid = <dynamic>{};
  for (final m in members(f)) {
  if (m.isParent) {
  if (m.idNum && !validIsraeliId(m.idNum)) add('ת"ז', T('entity.familyOf', 'משפחת') + ' ' + f.name + ': ת"ז של ' + m.first + ' (הורה) לא תקינה', f.id);
  continue;
}
  if (_falsy(m.birth)) add('ילדים', T('entity.familyOf', 'משפחת') + ' ' + f.name + ': ל' + m.first + ' אין תאריך לידה', f.id); else {
  var a = ageOf(m.birth);
  if (a != null && ((a < 0 || a > 25))) add('ילדים', T('entity.familyOf', 'משפחת') + ' ' + f.name + ': גיל חריג ל' + m.first + ' (' + a + ')', f.id);
}
  if (m.idNum && !validIsraeliId(m.idNum)) add('ת"ז', T('entity.familyOf', 'משפחת') + ' ' + f.name + ': ת"ז של ' + m.first + ' לא תקינה', f.id);
  var mp = phoneIssue(m.phone);
  if (mp) add('טלפון', T('entity.familyOf', 'משפחת') + ' ' + f.name + ': טלפון של ' + m.first + ' — ' + mp, f.id);
  var kk = m.first + '|' + ((m.birth ?? ''));
  if (seenKid.has(kk)) add('כפילות', T('entity.familyOf', 'משפחת') + ' ' + f.name + ': הילד/ה ' + m.first + ' מופיע/ה פעמיים', f.id);
  seenKid.add(kk);
}
}
  var famByMember = <dynamic, dynamic>{};
  for (final f in ((db.families is List) ? db.families : [])) for (final m in members(f)) famByMember.set(m.id, f);
  for (final e in ((db.enrollments is List) ? db.enrollments : [])) {
  var paid = ((e.payments ?? [])).fold(0, (a, x) => a + x.amount);
  if (e.totalDue && paid > e.totalDue) {
  var fam = famByMember.get(e.memberId);
  if (fam) add('לוגיקה', T('entity.familyOf', 'משפחת') + ' ' + fam.name + ': שולם ₪' + paid + ' — יותר מסה"כ העסקה (₪' + e.totalDue + '). בדקו החזר או עדכנו את הסכום', fam.id);
}
}
  var supByName = {};
  for (final sp in ((db.supporters is List) ? db.supporters : [])) {
  if (sp.idNum && digits(sp.idNum).length && !validIsraeliId(sp.idNum)) issues.add({'cat': 'ת"ז', 'title': 'תומכ/ת ' + sp.name + ': ת"ז לא תקינה (' + sp.idNum + ')', 'spId': sp.id});
  var pi = phoneIssue(sp.phone);
  if (pi) issues.add({'cat': 'טלפון', 'title': 'תומכ/ת ' + sp.name + ': ' + pi, 'spId': sp.id});
  if (sp.email && !EMAIL_RE.test(sp.email)) issues.add({'cat': 'אימייל', 'title': 'תומכ/ת ' + sp.name + ': אימייל לא תקין (' + sp.email + ')', 'spId': sp.id});
  var agg = supporterAggregates(sp);
  dynamic off(dynamic a, dynamic b) => _abs(((a ?? 0)) - ((b ?? 0))) > 0.5;
  if (((off(sp.ils, agg.ils) ?? off(sp.usd, agg.usd)) || ((sp.count ?? 0)) != agg.count)) issues.add({'cat': 'לוגיקה', 'title': 'תומכ/ת ' + sp.name + ': הסכום המצטבר הרשום (₪' + ((sp.ils ?? 0)) + (sp.usd ? ' + $' + sp.usd : '') + ' · ' + ((sp.count ?? 0)) + ' ' + T('entity.donations', 'תרומות') + ') לא תואם את פירוט ה' + T('entity.donations', 'תרומות') + ' (₪' + agg.ils + (agg.usd ? ' + $' + agg.usd : '') + ' · ' + agg.count + ' ' + T('entity.donations', 'תרומות') + ')', 'spId': sp.id});
  if (extra && todayIso && sp.nextDate && sp.nextDate < todayIso) issues.add({'cat': 'קשר', 'title': 'עבר יעד הקשר של "' + sp.name + '" (' + sp.nextDate + ')', 'spId': sp.id});
  if (extra) for (final d in (sp.donations is List) ? sp.donations : []) if (!(d.amount > 0)) issues.add({'cat': 'לוגיקה', 'title': T('entity.donation', 'תרומה') + ' בסכום ' + d.amount + ' אצל "' + sp.name + '" (' + d.rid + ')', 'spId': sp.id});
  var nk = normName(sp.name);
  if (nk) (supByName[nk] = (supByName[nk] ?? [])).add(sp.id);
}
  /*?ForInStatement?*/
  return issues;
}