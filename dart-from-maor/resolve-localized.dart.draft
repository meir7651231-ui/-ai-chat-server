var SITE_LANGS = ['he', 'en', 'yi'];
dynamic resolveLocalized(dynamic t, dynamic lang) {
  if (t == null) return '';
  if (t is String) return t;
  var pick = t[lang];
  if (pick is String && pick.trim()) return pick;
  if (t.he is String && t.he.trim()) return t.he;
  for (final l in SITE_LANGS) {
  var v = t[l];
  if (v is String && v.trim()) return v;
}
  return '';
}