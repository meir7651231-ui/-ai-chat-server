dynamic computeQuote(dynamic cfg, dynamic size, dynamic prices, dynamic nameOf, dynamic allModules, [dynamic addons = []], [dynamic mode = 'subscription']) {
  var onModules = allModules.where((m) => cfg.modules[m] != false);
  var all = onModules.map((m) => ({'key': m, 'label': nameOf(m), 'price': (prices.modules[m] ?? 0), 'kind': 'module'})).toList();
  var addonLines = addons.map((a) => ({'key': a.key, 'label': a.label, 'price': (prices.integrations[a.key] ?? 0), 'kind': 'integration'})).toList();
  var lines = [...all.where((l) => l.price > 0), ...addonLines.where((l) => l.price > 0)];
  var included = all.where((l) => l.price == 0);
  var modulesSubtotal = lines.fold(0, (s, l) => s + l.price);
  var sizeMult = (prices.sizeMult[size] ?? 1);
  var monthly = _round((prices.base + modulesSubtotal) * sizeMult);
  var setup = (prices.setup ?? 0);
  return {'lines': lines, 'included': included, 'base': prices.base, 'modulesSubtotal': modulesSubtotal, 'size': size, 'sizeMult': sizeMult, 'monthly': monthly, 'setup': setup, 'firstPayment': monthly + setup, 'yearly': monthly * 12, 'yearlyDiscounted': monthly * 10, 'mode': mode, 'enterpriseOneTime': prices.enterprise.oneTime, 'enterpriseAnnual': prices.enterprise.annualMaintenance};
}
