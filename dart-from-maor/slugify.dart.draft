var HEB2LAT = {'א': 'a', 'ב': 'b', 'ג': 'g', 'ד': 'd', 'ה': 'h', 'ו': 'v', 'ז': 'z', 'ח': 'ch', 'ט': 't', 'י': 'y', 'כ': 'k', 'ך': 'k', 'ל': 'l', 'מ': 'm', 'ם': 'm', 'נ': 'n', 'ן': 'n', 'ס': 's', 'ע': 'a', 'פ': 'p', 'ף': 'p', 'צ': 'ts', 'ץ': 'ts', 'ק': 'k', 'ר': 'r', 'ש': 'sh', 'ת': 't'};
dynamic slugify(dynamic orgName, dynamic taken) {
  var lat = [...orgName.trim().toLowerCase()].map((ch) => (HEB2LAT[ch] ?? ch)).toList().join('');
  var base = lat.replaceFirst(RegExp(r'[^a-z0-9]+'), '-').replaceFirst(RegExp(r'^-+|-+$'), '').replaceFirst(RegExp(r'--+'), '-');
  if (base.length < 2) base = 'org';
  if (base.length > 30) base = base.sublist(0, 30).replaceFirst(RegExp(r'-+$'), '');
  if (!taken.contains(base)) return base;
  for (var i = 2; ; i++) {
  var cand = base + '-' + i;
  if (!taken.contains(cand)) return cand;
}
}
