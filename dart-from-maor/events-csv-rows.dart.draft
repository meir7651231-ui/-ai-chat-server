var PRIORITY_LABEL = {'green': 'רגיל (ירוק)', 'orange': 'בינוני (כתום)', 'red': 'דחוף (אדום)'};
dynamic fmtD(dynamic iso) {
  if (_falsy(iso)) return '';
  var undefined = iso.split('-');
  return '${d}/${m}/${y}';
}
dynamic eventsCsvRows(dynamic db, dynamic config, dynamic termOf, dynamic hebDateFull, dynamic evMeta) {
  dynamic T(dynamic k, dynamic fb) => (config ? termOf(config, k, fb) : fb);
  var rows = [['כותרת', 'סוג אירוע', 'תאריך עברי', 'תאריך לועזי', 'שעה', T('entity.family', 'משפחה'), 'עדיפות', 'הערות', 'בוצע']];
  var evs = ([...db.events]..sort((a, b) => ((a.date ?? '')).localeCompare((b.date ?? ''))));
  for (final ev in evs) {
  rows.add([ev.title, (ev.customType ?? evMeta[ev.type].label), ev.date ? hebDateFull(ev.date) : '', fmtD(ev.date), (ev.time ?? ''), (db.families.firstWhere((f) => f.id == ev.famId).name ?? ''), (PRIORITY_LABEL[ev.priority] ?? ev.priority), (ev.notes ?? ''), ev.done ? 'כן' : 'לא']);
}
  return rows;
}
