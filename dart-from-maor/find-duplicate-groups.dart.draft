dynamic findDuplicateGroups(dynamic families, dynamic phonesOf, dynamic nameCityKey) {
  var parent = <dynamic, dynamic>{};
  dynamic find(dynamic x) {
  var r = x;
  while (parent.get(r) != r) r = parent.get(r);
  var c = x;
  while (parent.get(c) != r) {
  var nx = parent.get(c);
  parent.set(c, r);
  c = nx;
}
  return r;
}
  dynamic union(dynamic a, dynamic b) {
  var ra = find(a);
  var rb = find(b);
  if (ra != rb) parent.set(ra, rb);
}
  for (final f in families) parent.set(f.id, f.id);
  var byPhone = <dynamic, dynamic>{};
  var byNameCity = <dynamic, dynamic>{};
  for (final f in families) {
  for (final p in phonesOf(f)) {
  var prev = byPhone.get(p);
  if (prev) union(prev, f.id); else byPhone.set(p, f.id);
}
  var nk = nameCityKey(f);
  if (nk) {
  var prev = byNameCity.get(nk);
  if (prev) union(prev, f.id); else byNameCity.set(nk, f.id);
}
}
  var groups = <dynamic, dynamic>{};
  for (final f in families) {
  var r = find(f.id);
  ((groups.get(r) ?? groups.set(r, []).get(r))).add(f.id);
}
  return [...groups.values()].where((g) => g.length >= 2);
}
