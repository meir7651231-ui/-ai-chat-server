var AYIN_SHEET_HEADER = ['תומכת', 'טלפון', 'שם למסירה', 'כמה עיניים', 'נמסר (כן/לא)', 'שולם (כן/לא)', 'תשובה/הערה', 'עופרת בוצעה (כן/לא)'];
dynamic ayinSheetRows(dynamic supporters) {
  var rows = [[...AYIN_SHEET_HEADER]];
  for (final sp in supporters) {
  var a = sp.ayin;
  if (_falsy(a)) continue;
  var lastAns = a.answers[0];
  var leadDone = ['eyes', 'answer', 'done'].contains(a.stage) ? 'כן' : 'לא';
  for (final n in a.names) {
  rows.add([sp.name, (sp.phone ?? ''), n.name, (n.eyes == '' || n.eyes == null) ? '' : n.eyes.toString(), n.done ? 'כן' : 'לא', a.paid ? 'כן' : 'לא', (lastAns ? lastAns.note : (a.answeredNote ?? '')).replaceFirst(RegExp(r','), ' '), leadDone]);
}
}
  return rows;
}
