dynamic needsCare(dynamic db, dynamic todayIso, dynamic config, dynamic sockets) {
  var undefined = sockets;
  var holidays = upcomingHolidays(todayIso, shopHolidayDueDays);
  var due = [];
  var meetings = [];
  var coupons = [];
  var expired = [];
  var stock = [];
  for (final item in db.shopItems) {
  if (_falsy(item.active)) continue;
  var rem = itemRemaining(db, item.id);
  if (rem == 0) {
  stock.add({'kind': 'stockOut', 'assignmentId': '', 'componentId': item.id, 'label': item.name + ' — המלאי אזל', 'hint': 'לחדש מלאי או לעדכן את הפריט'});
} else if (item.minStock != null && rem != null && rem < item.minStock) {
  stock.add({'kind': 'restock', 'assignmentId': '', 'componentId': item.id, 'label': item.name + ' — המלאי נמוך', 'hint': 'להצטייד: נותרו ' + rem + ' מתחת ל-' + item.minStock});
}
  var waiting = (item.waits ?? []);
  if (waiting.length > 0 && rem != 0) {
  stock.add({'kind': 'waitingRestocked', 'assignmentId': '', 'componentId': item.id, 'label': waiting.length + ' ממתינים ל' + item.name, 'hint': 'המלאי חזר — אפשר לחלק לרשימת ההמתנה'});
}
}
  for (final p in db.shopProducts) {
  if (_falsy(p.active)) continue;
  for (final comp in p.components) {
  if (comp.itemId) continue;
  var rem = componentRemaining(comp.id, p.id, db.shopAssignments, comp.stock);
  if (rem == 0) {
  stock.add({'kind': 'stockOut', 'assignmentId': '', 'componentId': comp.id, 'label': comp.label + ' (' + p.name + ') — המלאי אזל', 'hint': 'לחדש מלאי או לעדכן את הרכיב במוצר'});
}
}
}
  for (final a in db.shopAssignments) {
  if (a.status != 'active') continue;
  var product = db.shopProducts.firstWhere((p) => p.id == a.productId);
  if (_falsy(product)) continue;
  var who = beneficiaryLabel(db, a, config);
  for (final comp in product.components) {
  var ri = itemOf(db, comp);
  if (ri.kind == 'holidayGift') {
  for (final h in holidays) {
  if (!holidayAllowed(ri, h.name)) continue;
  if (!assignmentRedeemed(a, comp.id, h)) {
  due.add({'kind': 'holidayDue', 'assignmentId': a.id, 'componentId': comp.id, 'label': who + ' — ' + ri.name, 'hint': h.name + ' ב-' + h.iso + ' — טרם נמסרה'});
}
}
} else if (ri.kind == 'meeting' && !assignmentRedeemed(a, comp.id)) {
  meetings.add({'kind': 'meetingPending', 'assignmentId': a.id, 'componentId': comp.id, 'label': who + ' — ' + ri.name, 'hint': 'פגישת ליווי טרם התקיימה'});
} else if (ri.kind == 'coupon' && !assignmentRedeemed(a, comp.id)) {
  var expiry = couponExpiry(a, ri);
  if (expiry && expiry < todayIso) {
  expired.add({'kind': 'couponExpired', 'assignmentId': a.id, 'componentId': comp.id, 'label': who + ' — ' + ri.name, 'hint': 'הקופון פג בתוקף ב-' + expiry + ' וטרם מומש'});
} else {
  coupons.add({'kind': 'couponPending', 'assignmentId': a.id, 'componentId': comp.id, 'label': who + ' — ' + ri.name, 'hint': expiry ? 'קופון טרם מומש · בתוקף עד ' + expiry : 'קופון טרם מומש'});
}
}
}
}
  var expiryOn = (_falsy(config) || featureOn(config, 'shop.expiry'));
  var expiring = (expiryOn ? expiringIntakes(db, todayIso) : []).map((x) => ({'kind': 'expiring', 'assignmentId': '', 'componentId': x.intake.itemId, 'label': x.itemName + (x.expired ? ' — פג תוקף' : ' — עומד לפוג'), 'hint': (x.expired ? 'פג ב-' : 'בתוקף עד ') + x.intake.expiry + ' · אצווה ' + x.intake.qty + ' יח׳'})).toList();
  return [...due, ...meetings, ...coupons, ...expired, ...stock, ...expiring];
}