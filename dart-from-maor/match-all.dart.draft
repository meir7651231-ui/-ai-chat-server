dynamic matchAll(dynamic incomings, dynamic allOpen, dynamic matchIncomingToPlanned) {
  var out = [];
  var used = <dynamic>{};
  var pool = [...allOpen];
  for (final inc in incomings) {
  var stillOpen = pool.where((r) => !used.has(r.plan.id));
  var m = matchIncomingToPlanned(inc, stillOpen);
  if (m) {
  out.add(m);
  used.add(m.plan.id);
}
}
  return out;
}
