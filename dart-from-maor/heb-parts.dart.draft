var fmtParts = Intl.DateTimeFormat('en-u-ca-hebrew', {'day': 'numeric', 'month': 'long', 'year': 'numeric'});
dynamic hebParts(dynamic d) {
  if ((d.millisecondsSinceEpoch).isNaN) return {'day': 0, 'month': '', 'year': 0};
  var parts = fmtParts.formatToParts(d);
  dynamic get(dynamic t) => (parts.firstWhere((p) => p.type == t).value ?? '');
  return {'day': +get('day'), 'month': get('month'), 'year': +get('year')};
}
