dynamic donCalMonthLine(dynamic entries, dynamic inMonth, dynamic config, dynamic termOf) {
  dynamic T(dynamic k, dynamic fb) => (config ? termOf(config, k, fb) : fb);
  var mc = 0;
  var mi = 0;
  var mu = 0;
  for (final e in entries) {
  if (!inMonth(e.date)) continue;
  mc++;
  if (e.cur == '$') mu += (e.amount ?? 0); else mi += (e.amount ?? 0);
}
  if (_falsy(mc)) return 'אין ' + T('entity.donations', 'תרומות') + ' מתועדות בחודש זה';
  var sums = (mi ? '₪' + mifunction toLocaleString() { [native code] } : '') + (mi && mu ? ' + ' : '') + (mu ? '$' + mufunction toLocaleString() { [native code] } : '');
  return mc + ' ' + T('entity.donations', 'תרומות') + ' החודש · ' + ((sums ?? 'סכומים מהקובץ ההיסטורי'));
}
