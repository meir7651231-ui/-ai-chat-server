dynamic annualReportLines(dynamic inp, dynamic donationsOfYear, dynamic money) {
  var rows = donationsOfYear(inp.donations, inp.year);
  var ils = rows.where((d) => d.cur != '$').fold(0, (a, d) => a + (_isFinite(d.amount) ? d.amount : 0));
  var usd = rows.where((d) => d.cur == '$').fold(0, (a, d) => a + (_isFinite(d.amount) ? d.amount : 0));
  var out = ['='._repeat(46), '        דוח תרומות שנתי — שנת ' + inp.year, '='._repeat(46), '', 'הארגון: ' + inp.orgName, ...(inp.orgTaxId ? ['מס׳ עמותה/מלכ"ר: ' + inp.orgTaxId] : []), 'התורם/ת: ' + inp.supporterName + (inp.payerId ? ' · ת"ז ' + inp.payerId : ''), '', '-'._repeat(46)];
  if (rows.length == 0) {
  out.add('אין תרומות רשומות בשנת ' + inp.year + '.');
} else {
  for (final d in rows) {
  out.add(d.date + '  ' + money(d.amount, d.cur)._padStart(12) + (d.rid ? '  קבלה ' + d.rid : '') + (d.designation ? '  · ' + d.designation : ''));
}
}
  out.add('-'._repeat(46));
  out.add('סה"כ ' + rows.length + ' תרומות בשנת ' + inp.year);
  if (ils > 0) out.add('סה"כ בשקלים: ' + money(ils));
  if (usd > 0) out.add('סה"כ בדולרים: ' + money(usd, '$'));
  if (inp.orgTaxId) {
  out.add('');
  out.add('לארגון אישור מוסד ציבורי לעניין תרומות לפי סעיף 46 לפקודת מס הכנסה.');
  out.add('דוח-ריכוז זה אינו קבלה — הקבלות המקוריות צוינו לצד כל תרומה.');
}
  if (inp.site) {
  out.add('');
  out.add(inp.site);
}
  return out;
}
