# build caches and outputs never enter the tree
android/.gradle/
android/build/
android/app/build/
android/local.properties
.gradle/
build/

# signing material never enters a public repo
keys/*.jks
keys/keystore.properties
android/keys/

# node
node_modules/

# gate results, per shard and commit (ship/release.mjs reads them)
gates/.last/
