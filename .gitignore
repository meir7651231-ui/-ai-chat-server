
# רישום-חציבה — פלט-מחלץ מתחדש (נבנה מחדש בכל הרצה), לא מקור
machtzev/registry/

# תלות-כלים vendored (c1) — נוצר מ-package.json, לא מקור
machtzev/node_modules/

# bypass-זמני של pre-tool (הוראת-בעלים בתוכו; נמחק בסוף-שלב) — לעולם לא נדחף
.allow_protocol_edit
.allow_*
machtzev/generator/gen-verify-last.log
server-gen/*/node_modules/
server-gen/*/package-lock.json
server-gen/*/firebase-debug.log
server-gen/*/firestore-debug.log
gen/looks/site/shots/
gen/looks/app/shots/
gen/looks/first10/shots/
.maimatai/

# מרחב-המדידה של מד-100 (machtzev/mahulal/meter-100.mjs · שלב-0): כל ריצה יוצרת
# goals/meterNNN + gen_goal_meterNNN*.dart ומוחקת אותם ב-finally (העץ חוזר לנוח · L14).
# תוצר-מדידה, לא מקור — ואסור שיהיה ניתן-לקומיט גם באמצע ריצה.
machtzev/generator/goals/meter[0-9]*/
new/dart-gen-bs/gen_goal_meter[0-9]*.dart

# מרחב-המדידה של nl-smoke --compile (‏NS_PREFIX='corp'): כל ריצה בונה אפליקציה למשפט
# ומוחקת את כולן ב-finally (‏wipe · העץ חוזר לנוח · L14). תוצר-מדידה, לא מקור —
# ואסור שיהיה ניתן-לקומיט באמצע ריצה (786 קבצים לא-עקובים נמדדו 18.9).
machtzev/generator/apps/corp[0-9]*.json
machtzev/generator/particle-plan-corp[0-9]*.json
machtzev/generator/report-plan-corp[0-9]*.md
new/dart-gen-bs/gen_app_corp[0-9]*.dart
new/dart-data-bs/auto/gen_app_corp[0-9]*.dart
