#!/usr/bin/env bash
# מחצב · commit-msg — שלב 1: הודעה ≥ 15 תווים · לא-זבל · trailer Protocol-Ran = sha256(tree-id ‖ ledger) (R2-2.3).
# ה-trailer הוא **עקביות-עצמית** (הראיה לריצת-שערים = CI/pre-push שמריצים משטרה מחדש), לא הוכחה. >1 trailer ⇒ נדחה.
MSG="$1"
GD="$(git rev-parse --absolute-git-dir)"
CLEAN=$(grep -v '^#' "$MSG")
LEN=$(printf '%s' "$CLEAN" | tr -d '[:space:]' | wc -c)
if [ "$LEN" -lt 15 ]; then echo "❌ הודעת commit קצרה מדי ($LEN תווים, מינימום 15)" >&2; exit 1; fi
FIRST=$(printf '%s\n' "$CLEAN" | head -1 | tr '[:upper:]' '[:lower:]')
if printf '%s' "$FIRST" | grep -qE '^(wip|test|asdf|tmp|fix|update|change|123|aaa|xxx|todo)[[:space:]]*$'; then echo "❌ הודעת commit לא-תיאורית: '$FIRST'" >&2; exit 1; fi
# ── שלב 6 · Allow: trailers (§6): פורמט + כיסוי-החלשות (מ-pre-commit) + pins-write לקובצי-חוקה. DoD: <שם> ⇒ חייב להופיע ב-diff (בלי הרצה — R2-3.5)
ENF=$(mktemp -d); git show HEAD:machtzev/allow-check.mjs > "$ENF/allow-check.mjs" 2>/dev/null || cp machtzev/allow-check.mjs "$ENF/allow-check.mjs"   # R3-1.1: אוכף מ-HEAD
if ! node "$ENF/allow-check.mjs" --msg "$MSG" --issues "$GD/protocol_ratchet_issues" --pins "$GD/protocol_pins_edits" --root "$(git rev-parse --show-toplevel)"; then echo "❌ commit-msg: Allow חסר/שגוי — ראה למעלה" >&2; exit 1; fi
DOD=$(grep -E '^DoD:' "$MSG" | head -1 | sed 's/^DoD:[[:space:]]*//')
if [ -n "$DOD" ]; then
  T=$(printf '%s' "$DOD" | grep -oE '[A-Za-z0-9_./-]+\.(test\.mjs|dart|mjs)' | head -1)
  if [ -n "$T" ] && ! git diff --cached --name-only | grep -qF "$(basename "$T")"; then echo "❌ DoD: '$T' לא מופיע ב-diff (שם-הבדיקה חייב להיות בשינוי — בלי הרצה)" >&2; exit 1; fi
fi
# ── שלב 7 · Wave: k/N (L20 גלים-של-10 · R2-5.15): פורמט + ≤10 קבצי-קוד ב-new/ בגל; בלי השדה ⇒ הצעה בלבד (wave-partition --staged)
WAVE=$(grep -E '^Wave:' "$MSG" | head -1)
NCODE=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^new/.*\.(mjs|js|dart)$' | grep -vE '\.test\.mjs$|_test\.dart$' | wc -l)
if [ -n "$WAVE" ]; then
  if ! printf '%s' "$WAVE" | grep -qE '^Wave:[[:space:]]*[0-9]+/[0-9]+([[:space:]]*·.*)?$'; then echo "❌ Wave: פורמט — 'Wave: k/N · m קבצים'" >&2; exit 1; fi
  if [ "$NCODE" -gt 10 ]; then echo "❌ Wave: $NCODE קבצי-קוד ב-new/ > 10 (L20: גל ≤10 — node machtzev/wave-partition.mjs --staged)" >&2; exit 1; fi
elif [ "$NCODE" -gt 10 ]; then echo "ℹ️ commit-msg: $NCODE קבצי-קוד ב-new/ ללא Wave: — לחלוקה: node machtzev/wave-partition.mjs --staged" >&2; fi
N=$(grep -c '^Protocol-Ran:' "$MSG" || true)
if [ "${N:-0}" -gt 1 ]; then echo "❌ יותר מ-trailer Protocol-Ran אחד" >&2; exit 1; fi
if [ -f "$GD/protocol_ledger" ]; then
  TREE=$(git write-tree 2>/dev/null || echo none)
  H=$( { printf '%s\n' "$TREE"; cat "$GD/protocol_ledger"; } | sha256sum | cut -c1-16)
  sed -i '/^Protocol-Ran:/d' "$MSG"
  printf '\nProtocol-Ran: %s\n' "$H" >> "$MSG"
fi
exit 0
